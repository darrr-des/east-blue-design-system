---
import { url } from '../lib/url';
import Base from '../layouts/Base.astro';
import fs from 'node:fs';
import path from 'node:path';

/**
 * Font Change Methodology page.
 *
 * Companion to the Assessment / Screen Design guides. Reads the standalone
 * `eb-font-change-guide.html` (the editable source-of-truth) and embeds just
 * its <main class="main"> body into the Astro layout, re-skinned to the current
 * design via the same `.guide-content`-scoped CSS as the other guide pages.
 *
 * The standalone header / back-button are stripped; the Astro chrome
 * (breadcrumb, cover, right-side TOC) replaces them.
 */

const HTML_PATH = path.resolve(process.cwd(), '..', 'eb-font-change-guide.html');
const raw = fs.readFileSync(HTML_PATH, 'utf8');

// Right-side "On this page" — order matches the source sections.
const TOC_SECTIONS = [
  { id: 'glance',       label: 'At a Glance' },
  { id: 'intent',       label: '1 · Intent & Criteria' },
  { id: 'architecture', label: '2 · Swap Architecture' },
  { id: 'compare',      label: '3 · Font Comparison' },
  { id: 'scorecard',    label: '4 · Compatibility Scorecard' },
  { id: 'rebind',       label: '5 · Rebind & Retune' },
  { id: 'screens',      label: '6 · Screen Regression' },
  { id: 'native',       label: '7 · Native Handoff' },
  { id: 'rollout',      label: '8 · Version & Rollout' },
  { id: 'checklist',    label: '9 · Font-Swap Checklist' },
];

// Extract the inner HTML of <main class="main"> ... </main>.
function extractMainBody(html: string): string {
  const start = html.indexOf('<main class="main">');
  const end = html.indexOf('</main>', start);
  if (start === -1 || end === -1) return '';
  let inner = html.slice(start + '<main class="main">'.length, end);

  // Strip the legacy back-button (Astro's breadcrumb replaces it).
  inner = inner.replace(/<a class="back-btn"[\s\S]*?<\/a>\s*/, '');

  // Strip the surrounding <div class="content-wrap"> open/close.
  inner = inner.replace(/^\s*<div class="content-wrap">/, '');
  inner = inner.replace(/<\/div>\s*<!--\s*\/content-wrap\s*-->\s*$/, '');

  return inner.trim();
}

const guideHtml = extractMainBody(raw);
---
<Base title="Font Change Methodology · East Blue">
  <div class="panel active guide-page">
    <div class="panel-layout">
      <div class="content-wrap">
        <nav class="guide-breadcrumb" aria-label="Breadcrumb">
          <a class="back-btn" href={url("/")}>Overview</a>
          <span class="guide-breadcrumb-sep" aria-hidden="true">›</span>
          <span class="guide-breadcrumb-current">Font Change Methodology</span>
        </nav>
        <div class="guide-content" set:html={guideHtml} />
      </div>
      <aside class="page-toc" aria-label="On this page">
        <div class="page-toc-label">On this page</div>
        <nav class="page-toc-nav">
          {TOC_SECTIONS.map((s) => (
            <a class="page-toc-link" href={`#${s.id}`} data-toc-target={s.id}>{s.label}</a>
          ))}
        </nav>
      </aside>
    </div>
  </div>
</Base>

<style is:global>
/* ────────────────────────────────────────────────────────────────────
   Font Change Methodology — same visual language as the other guides.
   All selectors scoped to `.guide-content` so styles don't leak.
   Mirrors eb-screen-design-guide.astro.
   ──────────────────────────────────────────────────────────────────── */

.guide-page { padding: 40px 0 80px; }

/* Cover — override global `.cover { display: none }` */
.guide-content .cover {
  display: block !important;
  padding: 8px 0 32px;
  border-bottom: 1px solid var(--sidebar-border);
  margin-bottom: 36px;
}
.guide-content .cover-eyebrow {
  display: block !important;
  font-size: 12px;
  font-weight: 600;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: #1972F9;
  margin-bottom: 10px;
}
.guide-content .cover-title {
  display: block !important;
  font-family: var(--font-heading);
  font-size: 28px;
  font-weight: 500;
  color: var(--text);
  line-height: 1.2;
  margin-bottom: 8px;
}
.guide-content .cover-subtitle {
  display: block !important;
  font-size: 14px;
  color: var(--muted);
  margin-bottom: 20px;
  line-height: 1.6;
  max-width: 72ch;
}

/* Sections */
.guide-content .page-section { margin-bottom: 48px; }
.guide-content .section-heading {
  font-family: var(--font-heading);
  font-size: 18px;
  font-weight: 600;
  color: var(--text);
  letter-spacing: -0.01em;
  margin-bottom: 6px;
  display: flex;
  align-items: center;
  gap: 10px;
}
.guide-content .sec-num {
  flex: 0 0 auto;
  width: 28px; height: 28px;
  border-radius: 9px;
  background: var(--accent); color: #fff;
  font-family: var(--font-heading);
  font-size: 14px; font-weight: 800;
  display: inline-flex; align-items: center; justify-content: center;
  box-shadow: 0 2px 5px rgba(0,92,229,0.3);
}
.guide-content .section-desc {
  font-size: 14px;
  color: var(--muted);
  margin-bottom: 16px;
  line-height: 1.65;
}
.guide-content .sub-heading {
  font-family: var(--font-heading);
  font-size: 16px;
  font-weight: 600;
  color: var(--text);
  margin-bottom: 12px;
  margin-top: 32px;
  letter-spacing: -0.01em;
}
.guide-content p {
  font-size: 14px;
  color: var(--text-2);
  line-height: 1.65;
  margin-bottom: 12px;
}
.guide-content p:last-child { margin-bottom: 0; }

/* Tables */
.guide-content .table-wrap {
  overflow: hidden;
  border-radius: 12px;
  background: var(--surface);
  border: 1px solid var(--sidebar-border);
  margin-bottom: 20px;
}
.guide-content table {
  width: 100%;
  border-collapse: collapse;
  font-size: 14px;
  margin: 0;
  border: 0;
}
.guide-content thead th {
  background: var(--thead-bg);
  padding: 10px 16px;
  text-align: left;
  font-size: 12px;
  font-weight: 600;
  color: var(--thead-fg);
  letter-spacing: 0.02em;
  white-space: nowrap;
  border-bottom: 0;
}
.guide-content tbody td {
  padding: 11px 16px;
  border-top: 1px solid var(--row-border);
  vertical-align: top;
  color: var(--text-2);
}
.guide-content tbody tr:first-child td { border-top: 0; }
.guide-content td.mono { font-family: var(--mono); font-size: 12px; }
.guide-content td strong, .guide-content tbody td strong { font-weight: 600; color: var(--text); }

/* Code */
.guide-content code {
  font-family: var(--mono);
  font-size: 12px;
  font-weight: 600;
  background: var(--code-bg);
  padding: 1px 4px;
  border-radius: 3px;
  color: var(--code-fg);
}

/* Dep / step cards */
.guide-content .dep-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12px;
  margin-top: 16px;
}
.guide-content .dep-card,
.guide-content .step-card {
  background: #F1F1F4;
  border-radius: 12px;
  padding: 20px;
  margin-bottom: 12px;
}
[data-theme="dark"] .guide-content .dep-card,
[data-theme="dark"] .guide-content .step-card { background: #262626; }
.guide-content .dep-label,
.guide-content .step-label {
  font-size: 12px;
  font-weight: 700;
  letter-spacing: 0.07em;
  text-transform: capitalize;
  color: var(--accent);
  margin-bottom: 6px;
}
.guide-content .dep-title,
.guide-content .step-title {
  font-family: var(--font-heading);
  font-size: 16px;
  font-weight: 600;
  color: var(--text);
  margin-bottom: 6px;
}
.guide-content .dep-desc,
.guide-content .step-body {
  font-size: 14px;
  color: var(--muted);
  line-height: 1.6;
}

/* Infobox */
.guide-content .infobox {
  border-radius: 12px;
  padding: 14px 16px;
  font-size: 13px;
  line-height: 1.65;
  margin: 16px 0;
  background: var(--accent-light);
  border: 1px solid var(--issue-border);
  color: var(--text-2);
}
.guide-content .infobox strong { color: var(--text); font-weight: 600; }

/* Badges */
.guide-content .badge {
  display: inline-flex;
  align-items: center;
  padding: 2px 8px;
  border-radius: 999px;
  font-size: 12px;
  font-weight: 600;
  white-space: nowrap;
}
.guide-content .badge-keep        { color: #1A7A4A; background: #E6F4ED; }
.guide-content .badge-fix         { color: #B45309; background: #FEF3C7; }
.guide-content .badge-restructure { color: #9333EA; background: #F3E8FF; }
.guide-content .badge-rework      { color: #991B1B; background: #FEE2E2; }

/* Footer */
.guide-content .footer {
  border-top: 1px solid var(--border);
  padding-top: 20px;
  font-size: 12px;
  color: var(--muted);
  text-align: center;
  margin-top: 64px;
}

/* ── Visuals ─────────────────────────────────────────────────────────── */
.guide-content .viz { margin: 4px 0 22px; }
.guide-content .viz-cap { font-size: 12px; color: var(--muted); margin-top: 10px; text-align: center; }

/* Type specimen */
.guide-content .viz-type { display: flex; flex-direction: column; gap: 8px; padding: 4px 0; }
.guide-content .viz-ty-row {
  display: flex; align-items: baseline; justify-content: space-between; gap: 16px;
  border-bottom: 1px solid var(--row-border); padding-bottom: 8px;
}
.guide-content .viz-ty-row:last-child { border-bottom: 0; }
.guide-content .viz-ty-spec { color: var(--text); font-weight: 600; line-height: 1.15; }
.guide-content .viz-ty-meta { font-family: var(--mono); font-size: 11px; color: var(--muted); white-space: nowrap; }
.guide-content .viz-ty-28 { font-size: 28px; font-family: var(--font-heading); }
.guide-content .viz-ty-20 { font-size: 20px; }
.guide-content .viz-ty-18 { font-size: 18px; }
.guide-content .viz-ty-16 { font-size: 16px; }
.guide-content .viz-ty-14 { font-size: 14px; }
.guide-content .viz-ty-12 { font-size: 12px; }

/* At-a-glance stat cards */
.guide-content .viz-stats { display: grid; grid-template-columns: repeat(4, 1fr); gap: 12px; margin: 8px 0 4px; }
.guide-content .viz-stat { background: var(--accent-light); border-radius: 12px; padding: 16px 12px; text-align: center; }
.guide-content .viz-stat-num { display: block; font-family: var(--font-heading); font-size: 22px; font-weight: 700; color: var(--accent); line-height: 1.1; }
.guide-content .viz-stat-lbl { display: block; font-size: 11px; color: var(--muted); margin-top: 6px; font-weight: 600; }

/* One-line rule highlight */
.guide-content .rule {
  display: flex; align-items: center; gap: 10px;
  background: var(--surface); border: 1px solid var(--row-border); border-left: 3px solid var(--accent);
  border-radius: 8px; padding: 11px 16px; margin: 0 0 16px;
  font-size: 14px; font-weight: 600; color: var(--text);
}
.guide-content .rule::before {
  content: "✓"; display: inline-flex; align-items: center; justify-content: center;
  width: 18px; height: 18px; border-radius: 50%; background: var(--accent); color: #fff;
  font-size: 11px; flex-shrink: 0;
}

/* Do / Don't pairs */
.guide-content .viz-dodont { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin: 4px 0 20px; }
.guide-content .dd { border-radius: 12px; padding: 16px; border: 1px solid var(--row-border); }
.guide-content .dd-do   { background: rgba(26,122,74,0.10);  border-color: rgba(26,122,74,0.30); }
.guide-content .dd-dont { background: rgba(185,28,28,0.10); border-color: rgba(185,28,28,0.30); }
.guide-content .dd-tag { font-size: 12px; font-weight: 700; margin-bottom: 12px; }
.guide-content .dd-do .dd-tag   { color: #1A7A4A; }
.guide-content .dd-dont .dd-tag { color: #B91C1C; }
.guide-content .dd-body { font-size: 13px; color: var(--muted); line-height: 1.55; margin-top: 10px; }
.guide-content .dd-body strong { color: var(--text); font-weight: 600; }

/* Gates (§1) */
.guide-content .viz-gates { display: flex; flex-wrap: wrap; gap: 8px; margin: 4px 0 6px; }
.guide-content .viz-gate {
  display: inline-flex; align-items: center; gap: 6px; padding: 7px 12px;
  border-radius: 8px; background: var(--accent-light); color: var(--accent);
  font-size: 12px; font-weight: 700; border: 1px solid var(--issue-border);
}
.guide-content .viz-gate-ico { font-size: 12px; }

/* Binding diagram (§2) */
.guide-content .viz-bind { display: flex; align-items: stretch; gap: 10px; flex-wrap: wrap; margin: 4px 0 10px; }
.guide-content .viz-bind-node {
  flex: 1; min-width: 110px; border-radius: 12px; padding: 14px 12px; text-align: center;
  border: 1px solid var(--row-border); background: var(--surface);
  display: flex; flex-direction: column; justify-content: center;
}
.guide-content .viz-bind-layers { display: flex; flex-direction: column; gap: 5px; margin-bottom: 8px; }
.guide-content .viz-bind-layer { height: 9px; border-radius: 3px; background: var(--code-bg); }
.guide-content .viz-bind-swap { background: var(--accent-light); border-color: var(--accent); }
.guide-content .viz-bind-title { font-size: 13px; font-weight: 700; color: var(--text); }
.guide-content .viz-bind-sub { font-size: 10px; color: var(--muted); margin-top: 3px; font-family: var(--mono); }
.guide-content .viz-bind-badge { font-size: 10px; font-weight: 700; color: var(--accent); margin-top: 8px; }
.guide-content .viz-bind-swap .viz-bind-title { color: var(--accent); }
.guide-content .viz-bind-arrow { color: var(--muted); font-size: 20px; flex: 0 0 auto; align-self: center; }
.guide-content .viz-leak { display: flex; align-items: center; gap: 8px; font-size: 12px; color: var(--muted); }
.guide-content .viz-leak-chip {
  padding: 4px 10px; border-radius: 99px; background: rgba(185,28,28,0.10);
  border: 1px dashed rgba(185,28,28,0.45); color: #C0392B; font-weight: 700; flex-shrink: 0;
}

/* Width comparison (§3) */
.guide-content .viz-width { display: flex; flex-direction: column; gap: 10px; padding: 4px 0; }
.guide-content .viz-width-row { display: flex; align-items: center; gap: 12px; }
.guide-content .viz-width-lbl { width: 80px; font-size: 11px; font-family: var(--mono); color: var(--muted); flex-shrink: 0; }
.guide-content .viz-width-bar {
  height: 24px; border-radius: 6px; background: var(--accent-light); border: 1px solid var(--issue-border);
  display: flex; align-items: center; padding: 0 10px; font-size: 11px; color: var(--accent);
  font-weight: 600; white-space: nowrap; overflow: hidden;
}
.guide-content .viz-width-bar-wide { background: rgba(224,69,123,0.14); border-color: rgba(224,69,123,0.4); color: #C0392B; }

/* Box fit (§5) */
.guide-content .viz-fit { display: flex; gap: 14px; flex-wrap: wrap; padding: 4px 0; }
.guide-content .viz-fit-col { flex: 1; min-width: 120px; }
.guide-content .viz-fit-box {
  height: 50px; border-radius: 99px; display: flex; align-items: center; justify-content: center;
  background: var(--accent); color: #fff; font-weight: 700; font-size: 15px; overflow: hidden;
}
.guide-content .viz-fit-bad { font-size: 22px; align-items: flex-start; line-height: 1.1; }
.guide-content .viz-fit-cap { font-size: 11px; margin-top: 8px; text-align: center; color: var(--muted); }
.guide-content .viz-fit-cap-ok { color: #1A7A4A; font-weight: 600; }
.guide-content .viz-fit-cap-bad { color: #C0392B; font-weight: 600; }

/* Reflow cards (§6) */
.guide-content .viz-reflow { display: flex; gap: 24px; justify-content: center; flex-wrap: wrap; padding: 4px 0; }
.guide-content .viz-mini { width: 170px; }
.guide-content .viz-card { border: 1px solid var(--row-border); border-radius: 10px; padding: 12px; background: var(--surface); }
.guide-content .viz-card-title { height: 11px; width: 55%; background: var(--accent); opacity: 0.85; border-radius: 3px; margin-bottom: 10px; }
.guide-content .viz-card-line { height: 9px; background: var(--code-bg); border-radius: 3px; margin-bottom: 7px; }
.guide-content .viz-card-line:last-child { margin-bottom: 0; }
.guide-content .viz-card-over { border-color: #E0457B; }
.guide-content .viz-card-line-clip { background: rgba(224,69,123,0.4); }
.guide-content .viz-mini-cap { font-size: 11px; text-align: center; margin-top: 8px; color: var(--muted); }

/* Merge flow (§8) */
.guide-content .viz-flow { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; padding: 4px 0; }
.guide-content .viz-flow-node {
  padding: 8px 14px; border-radius: 8px; background: var(--accent-light); color: var(--accent);
  font-size: 12px; font-weight: 700; border: 1px solid var(--issue-border);
}
.guide-content .viz-flow-arrow { color: var(--muted); font-size: 16px; }

/* Methodology pipeline hero (§0) */
.guide-content .viz-pipeline { display: flex; align-items: flex-start; gap: 0; flex-wrap: wrap; margin: 6px 0 24px; }
.guide-content .pl-step { flex: 1; min-width: 104px; position: relative; text-align: center; padding: 0 4px; display: flex; flex-direction: column; align-items: center; }
.guide-content .pl-step::before { content: ""; position: absolute; top: 17px; left: -50%; width: 100%; height: 2px; background: var(--issue-border); z-index: 0; }
.guide-content .pl-step:first-child::before { display: none; }
.guide-content .pl-num {
  position: relative; z-index: 1; width: 34px; height: 34px; border-radius: 50%;
  background: var(--accent); color: #fff; font-family: var(--font-heading);
  font-weight: 800; font-size: 14px; display: flex; align-items: center; justify-content: center;
  margin-bottom: 9px; box-shadow: 0 3px 8px rgba(0,92,229,0.35);
}
.guide-content .pl-ico { font-size: 17px; line-height: 1; margin-bottom: 5px; }
.guide-content .pl-title { font-size: 12px; font-weight: 700; color: var(--text); line-height: 1.25; }
.guide-content .pl-sub { font-size: 10px; color: var(--muted); margin-top: 2px; }

/* ── Realistic UI mockups ──────────────────────────────────────────── */
.guide-content .ui-gallery { display: flex; gap: 24px; flex-wrap: wrap; justify-content: center; padding: 4px 0; }
.guide-content .ui-col { display: flex; flex-direction: column; align-items: center; }
.guide-content .ui-demo-cap { font-size: 11px; text-align: center; margin-top: 10px; color: var(--muted); max-width: 236px; }
.guide-content .ui-demo-cap-bad { color: #C0392B; font-weight: 600; }
.guide-content .ui-demo-cap-ok { color: #1A7A4A; font-weight: 600; }

/* List + transaction row */
.guide-content .ui-list { border: 1px solid var(--row-border); border-radius: 12px; overflow: hidden; background: var(--surface); }
.guide-content .ui-row { display: flex; align-items: center; gap: 10px; padding: 11px 12px; border-top: 1px solid var(--row-border); }
.guide-content .ui-row:first-child { border-top: 0; }
.guide-content .ui-avatar { width: 34px; height: 34px; border-radius: 50%; background: var(--accent-light); color: var(--accent); display: flex; align-items: center; justify-content: center; font-size: 12px; font-weight: 700; flex-shrink: 0; }
.guide-content .ui-row-main { flex: 1; min-width: 0; }
.guide-content .ui-row-name { font-size: 13px; font-weight: 600; color: var(--text); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.guide-content .ui-row-sub { font-size: 11px; color: var(--muted); margin-top: 2px; }
.guide-content .ui-row-amt { font-size: 13px; font-weight: 700; color: var(--text); flex-shrink: 0; white-space: nowrap; }
.guide-content .ui-row-amt-pos { color: #1A7A4A; }
.guide-content .ui-row-broken { flex-wrap: wrap; }
.guide-content .ui-row-broken .ui-row-main { flex: 1 1 auto; }
.guide-content .ui-row-broken .ui-row-amt { width: 100%; text-align: right; color: #C0392B; margin-top: 2px; }

/* Button */
.guide-content .ui-btn { height: 48px; border-radius: 99px; background: var(--accent); color: #fff; display: flex; align-items: center; justify-content: center; font-size: 15px; font-weight: 700; }
.guide-content .ui-btn-clip { font-size: 21px; align-items: flex-start; line-height: 1.05; overflow: hidden; }

/* Phone screen */
.guide-content .ui-phone { width: 236px; border: 1px solid var(--row-border); border-radius: 26px; background: var(--code-bg); padding: 8px; overflow: hidden; }
.guide-content .ui-status { display: flex; justify-content: space-between; align-items: center; padding: 3px 8px 7px; font-size: 10px; font-weight: 700; color: var(--text); }
.guide-content .ui-status-dots { display: flex; gap: 3px; }
.guide-content .ui-status-dots span { width: 5px; height: 5px; border-radius: 50%; background: var(--text); opacity: 0.6; }
.guide-content .ui-hd { display: flex; align-items: center; gap: 8px; padding: 2px 4px 10px; }
.guide-content .ui-hd-back { font-size: 17px; color: var(--text); line-height: 1; }
.guide-content .ui-hd-title { font-size: 14px; font-weight: 700; color: var(--text); }
.guide-content .ui-balance { background: var(--accent); border-radius: 14px; padding: 14px; color: #fff; margin-bottom: 12px; }
.guide-content .ui-balance-lbl { font-size: 10px; opacity: 0.85; }
.guide-content .ui-balance-amt { font-size: 22px; font-weight: 800; margin-top: 3px; letter-spacing: -0.01em; }
.guide-content .ui-seclabel { font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: var(--muted); margin: 0 2px 6px; }
.guide-content .ui-dock { margin-top: 12px; }

@media (max-width: 640px) {
  .guide-content .dep-grid { grid-template-columns: 1fr; }
  .guide-content .viz-stats { grid-template-columns: repeat(2, 1fr); }
  .guide-content .viz-dodont { grid-template-columns: 1fr; }
}
</style>
