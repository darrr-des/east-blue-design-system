---
import Base from '../layouts/Base.astro';

const feature = Astro.url.searchParams.get('feature') || 'This page';
---
<Base title={`${feature} · Coming soon · East Blue`}>
  <div class="page">
    <div class="page-content coming-soon-wrap">
      <div class="coming-soon-card">
        <div class="coming-soon-icon">
          <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="10" />
            <polyline points="12 6 12 12 16 14" />
          </svg>
        </div>
        <h1 class="coming-soon-title">{feature} is coming soon</h1>
        <p class="coming-soon-desc">
          This area is still under construction. We'll roll it out in a follow-up release.
        </p>
        <a class="coming-soon-back" href="/">
          <svg width="14" height="14" viewBox="0 0 16 16" fill="none">
            <path d="M10 12L6 8l4-4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
          Back to Overview
        </a>
      </div>
    </div>
  </div>
</Base>
