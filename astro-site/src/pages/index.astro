---
import { url } from '../lib/url';
import Base from '../layouts/Base.astro';

const steps = [
  {
    num: '01',
    eyebrow: 'Assess',
    title: 'Evaluate',
    body: 'Inspect each Figma component against 7 criteria covering structure, naming, tokens, states, and Code Connect readiness.',
  },
  {
    num: '02',
    eyebrow: 'Document',
    title: 'Write',
    body: 'Author a per-component data file in src/data/components/ with verdicts, traits, spec cards, and SwiftUI/Compose snippets.',
  },
  {
    num: '03',
    eyebrow: 'Build',
    title: 'Assemble',
    body: 'Run npm run build — Astro compiles all 79 component pages into static HTML automatically.',
  },
  {
    num: '04',
    eyebrow: 'Ship',
    title: 'Publish',
    body: 'Commit and push to main. The deploy workflow rebuilds the live site automatically.',
  },
];

const criteria = [
  { id: 'C1', name: 'Layer Structure & Naming',     check: 'Layers should use semantic names like leading-icon or content — not Figma defaults like Frame 42 or Group 7. The hierarchy should be logical and free of orphaned wrappers.' },
  { id: 'C2', name: 'Variant & Property Naming',    check: 'Booleans should be true/false (not yes/no), enums should match the values native code expects, and property names should map cleanly to API parameters.' },
  { id: 'C3', name: 'Token Coverage',               check: 'Every color, size, radius, and spacing value should be bound to a design token. No hardcoded hex codes or pixel values.' },
  { id: 'C4', name: 'Native Mappability',           check: 'The component should map cleanly to a native SwiftUI / Compose primitive. No web-only patterns (CSS-only effects, hover-dependent UX, etc.).' },
  { id: 'C5', name: 'Interaction State Coverage',   check: 'All required states should exist as variants: default, pressed, focused, disabled, and any feature-specific states (loading, error, etc.).' },
  { id: 'C6', name: 'Asset & Icon Quality',         check: 'Icons should be vector instances with token-based coloring. No raster PNGs, no flattened paths, no hardcoded fills.' },
  { id: 'C7', name: 'Code Connect Linkability',     check: 'Property names should map 1:1 to native parameters with no transformation needed. Code Connect mapping should be straightforward.' },
];

const traits = [
  { rating: 'Pass',    cls: 'pass',    body: 'Fully met — ready for native handoff.' },
  { rating: 'Partial', cls: 'partial', body: 'Mostly met with minor gaps (e.g. missing icon slots, but text variants work).' },
  { rating: 'Warn',    cls: 'warn',    body: 'Significant concerns that limit reuse or block handoff (e.g. naming issues, raster assets, hardcoded values).' },
  { rating: 'Fail',    cls: 'fail',    body: 'Broken — blocks DS inclusion or native implementation (e.g. flattened icons, no separable layers).' },
];

const verdicts = [
  { name: 'Keep',          cls: 'badge-keep',          body: 'All 4 traits pass. Ship as-is.' },
  { name: 'Fix',           cls: 'badge-fix',           body: 'Belongs in DS but has specific issues. Mostly pass/partial with a few warn.' },
  { name: 'Restructure',   cls: 'badge-restructure',   body: 'Needs significant property or architectural changes.' },
  { name: 'Consolidate',   cls: 'badge-consolidate',   body: 'Merge into another component.' },
  { name: 'Product Layer', cls: 'badge-product-layer', body: 'Too feature-specific for core DS.' },
  { name: 'Remove',        cls: 'badge-remove',        body: 'Redundant, deprecated, or not a DS concern.' },
];
---
<Base title="East Blue — Design System Assessment">
  <div class="page">
    <div class="page-content">
      <header class="page-header">
        <h1>Overview</h1>
        <p>Evaluating DS health and native mobile readiness for SwiftUI and Jetpack Compose.</p>
      </header>

      <section class="page-section">
        <h2>How It Works</h2>
        <p class="section-desc">Each component is evaluated against seven criteria. The report is self-contained and versions alongside the design system.</p>

        <div class="how-grid">
          {steps.map((s) => (
            <div class="how-card">
              <div class="how-step">{s.num} — {s.eyebrow}</div>
              <div class="how-title">{s.title}</div>
              <p class="how-desc">{s.body}</p>
            </div>
          ))}
        </div>
      </section>

      <section class="page-section">
        <h2>Assessment Criteria</h2>
        <p class="section-desc">The overall status reflects the weakest criterion — one unresolved issue can block Code Connect linkability.</p>

        <div class="table-wrap">
          <table>
            <thead>
              <tr>
                <th class="col-id">ID</th>
                <th class="col-md">Criterion</th>
                <th>What we check</th>
              </tr>
            </thead>
            <tbody>
              {criteria.map((c) => (
                <tr>
                  <td class="mono"><strong>{c.id}</strong></td>
                  <td><strong>{c.name}</strong></td>
                  <td>{c.check}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>

      <section class="page-section">
        <h2>Trait Ratings</h2>
        <p class="section-desc">Per-trait scores for each component (Reusable, Self-contained, Consistent, Composable).</p>

        <div class="table-wrap">
          <table>
            <thead>
              <tr>
                <th class="col-md">Rating</th>
                <th>Meaning</th>
              </tr>
            </thead>
            <tbody>
              {traits.map((t) => (
                <tr>
                  <td><span class={`trait-rating ${t.cls}`}>{t.rating}</span></td>
                  <td>{t.body}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>

      <section class="page-section">
        <h2>DS Verdicts</h2>
        <p class="section-desc">Overall DS Health outcome from all 4 traits.</p>

        <div class="table-wrap">
          <table>
            <thead>
              <tr>
                <th class="col-md">Verdict</th>
                <th>Meaning</th>
              </tr>
            </thead>
            <tbody>
              {verdicts.map((v) => (
                <tr>
                  <td><span class={`badge ${v.cls}`}>{v.name}</span></td>
                  <td>{v.body}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>

      <section class="page-section">
        <a class="overview-cta" href={url("/eb-ds-assessment-guide")}>
          <div class="overview-cta-text">
            <span class="overview-cta-eyebrow">Next</span>
            <span class="overview-cta-title">Read the Assessment Guide</span>
            <span class="overview-cta-sub">Methodology, scoring rubric, and the full set of open issues, patterns, and component status references.</span>
          </div>
          <span class="overview-cta-arrow" aria-hidden="true">
            <svg width="18" height="18" viewBox="0 0 16 16" fill="none">
              <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </span>
        </a>
      </section>

      <section class="page-section">
        <a class="overview-cta" href={url("/eb-screen-design-guide")}>
          <div class="overview-cta-text">
            <span class="overview-cta-eyebrow">Designing a screen</span>
            <span class="overview-cta-title">Read the Screen Design Guide</span>
            <span class="overview-cta-sub">How to lay out a new GCash screen — anatomy, frame, spacing, headers, type, which buttons to use, and the exact Figma setup spec.</span>
          </div>
          <span class="overview-cta-arrow" aria-hidden="true">
            <svg width="18" height="18" viewBox="0 0 16 16" fill="none">
              <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </span>
        </a>
      </section>

      <section class="page-section">
        <a class="overview-cta" href={url("/eb-property-naming-guidelines")}>
          <div class="overview-cta-text">
            <span class="overview-cta-eyebrow">Naming a property</span>
            <span class="overview-cta-title">Read the Property Naming Guidelines</span>
            <span class="overview-cta-sub">The naming contract for every component property — casing by type, boolean verb prefixes, standardized values, State vs Status, and the governance checklist. Divergences are assessed as C2.</span>
          </div>
          <span class="overview-cta-arrow" aria-hidden="true">
            <svg width="18" height="18" viewBox="0 0 16 16" fill="none">
              <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </span>
        </a>
      </section>

      <section class="page-section">
        <a class="overview-cta" href={url("/eb-font-change-guide")}>
          <div class="overview-cta-text">
            <span class="overview-cta-eyebrow">Changing a typeface</span>
            <span class="overview-cta-title">Read the Font Change Methodology</span>
            <span class="overview-cta-sub">How to swap a font across the system without breaking screens — intent gates, metric comparison, the one-point rebind, retuning, screen regression, and native handoff.</span>
          </div>
          <span class="overview-cta-arrow" aria-hidden="true">
            <svg width="18" height="18" viewBox="0 0 16 16" fill="none">
              <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </span>
        </a>
      </section>
    </div>
  </div>
</Base>
