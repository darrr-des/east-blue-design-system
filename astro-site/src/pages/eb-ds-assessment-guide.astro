---
import { url } from '../lib/url';
import Base from '../layouts/Base.astro';
import fs from 'node:fs';
import path from 'node:path';
import { marked } from 'marked';

/**
 * Assessment Guide — the methodology (traits, criteria, verdicts, GCash
 * patterns), rendered from the one source: `../eb-ds-assessment-guide.md`.
 * Sessions read the same file, so the page and the rule can never differ.
 */
const MD_PATH = path.resolve(process.cwd(), '..', 'eb-ds-assessment-guide.md');
const md = fs.readFileSync(MD_PATH, 'utf8');

const slugify = (s: string) =>
  s.toLowerCase().replace(/<[^>]+>/g, '').replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');

const toc: { id: string; label: string }[] = [];
marked.use({
  renderer: {
    heading({ tokens, depth }) {
      const text = this.parser.parseInline(tokens);
      const id = slugify(text);
      if (depth === 2) toc.push({ id, label: text.replace(/<[^>]+>/g, '') });
      const cls = depth === 1 ? 'cover-title' : depth === 2 ? 'section-heading' : 'sub-heading';
      return `<h${depth} id="${id}" class="${cls}">${text}</h${depth}>\n`;
    },
  },
});

let guideHtml = marked.parse(md) as string;
// Tables scroll inside their own wrapper; the body never scrolls sideways.
guideHtml = guideHtml.replace(/<table>/g, '<div class="table-wrap"><table>').replace(/<\/table>/g, '</table></div>');
---
<Base title="Assessment Guide · East Blue">
  <div class="panel active guide-page">
    <div class="panel-layout">
      <div class="content-wrap">
        <nav class="guide-breadcrumb" aria-label="Breadcrumb">
          <a class="back-btn" href={url("/")}>Overview</a>
          <span class="guide-breadcrumb-sep" aria-hidden="true">›</span>
          <span class="guide-breadcrumb-current">Assessment Guide</span>
        </nav>
        <div class="guide-content" set:html={guideHtml} />
        <a class="overview-cta guide-methodology-cta" href={url("/eb-methodology")}>
          <div class="overview-cta-text">
            <span class="overview-cta-eyebrow">The why behind the why</span>
            <span class="overview-cta-title">Read the Assessment Methodology</span>
            <span class="overview-cta-sub">Every rating, score, and level explained across 12 parts — what it is, how we arrived at it, and why it exists. One table per concept.</span>
          </div>
          <span class="overview-cta-arrow" aria-hidden="true">
            <svg width="18" height="18" viewBox="0 0 16 16" fill="none">
              <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </span>
        </a>
      </div>
      <aside class="page-toc" aria-label="On this page">
        <div class="page-toc-label">On this page</div>
        <nav class="page-toc-nav">
          {toc.map((s) => (
            <a class="page-toc-link" href={`#${s.id}`} data-toc-target={s.id}>{s.label}</a>
          ))}
        </nav>
      </aside>
    </div>
  </div>
</Base>

<style is:global>
/* Assessment Guide — scoped to `.guide-content` so nothing leaks. */
.guide-page { padding: 40px 0 80px; }

.guide-content .cover-title {
  font-family: var(--font-heading);
  font-size: 28px;
  font-weight: 500;
  color: var(--text);
  line-height: 1.2;
  margin: 0 0 24px;
  padding-bottom: 24px;
  border-bottom: 1px solid var(--sidebar-border);
}
.guide-content .section-heading {
  font-family: var(--font-heading);
  font-size: 18px;
  font-weight: 600;
  color: var(--text);
  letter-spacing: -0.01em;
  margin: 40px 0 8px;
}
.guide-content .sub-heading {
  font-family: var(--font-heading);
  font-size: 15px;
  font-weight: 600;
  color: var(--text);
  margin: 28px 0 8px;
  letter-spacing: -0.01em;
}
.guide-content hr { border: 0; border-top: 1px solid var(--sidebar-border); margin: 40px 0; }
.guide-content p {
  font-size: 14px;
  color: var(--text-2);
  line-height: 1.65;
  margin: 0 0 12px;
  max-width: 72ch;
}
.guide-content blockquote {
  margin: 12px 0 16px;
  padding: 10px 16px;
  border-left: 3px solid var(--accent);
  background: var(--surface);
  border-radius: 0 8px 8px 0;
}
.guide-content blockquote p { margin: 0; }
.guide-content strong { font-weight: 600; color: var(--text); }
.guide-content a { color: var(--accent); text-decoration: none; }
.guide-content a:hover { text-decoration: underline; }

/* Tables */
.guide-content .table-wrap {
  overflow-x: auto;
  border-radius: 12px;
  background: var(--surface);
  border: 1px solid var(--sidebar-border);
  margin: 12px 0 20px;
}
.guide-content table {
  width: 100%;
  border-collapse: collapse;
  font-size: 14px;
  margin: 0;
  border: 0;
  border-radius: 0;
}
.guide-content thead th {
  background: var(--thead-bg);
  padding: 10px 16px;
  text-align: left;
  font-size: 12px;
  font-weight: 600;
  color: var(--thead-fg);
  letter-spacing: 0.02em;
  white-space: nowrap;
  border-bottom: 0;
}
.guide-content tbody td {
  padding: 11px 16px;
  border-top: 1px solid var(--row-border);
  vertical-align: top;
  color: var(--text-2);
}
.guide-content tbody tr:first-child td { border-top: 0; }
.guide-content td strong { font-weight: 600; color: var(--text); }

/* Badges */
.guide-content .badge {
  display: inline-flex;
  align-items: center;
  padding: 2px 8px;
  border-radius: 999px;
  font-size: 12px;
  font-weight: 600;
  letter-spacing: normal;
  white-space: nowrap;
}
.guide-content .badge-ready       { background: var(--ready-bg);  color: var(--ready-fg); }
.guide-content .badge-refine      { background: var(--refine-bg); color: var(--refine-fg); }
.guide-content .badge-rework      { background: var(--rework-bg); color: var(--rework-fg); }
.guide-content .badge-na          { background: var(--na-bg);     color: var(--na-fg); }
.guide-content .badge-keep        { color: #1A7A4A; background: #E6F4ED; }
.guide-content .badge-fix         { color: #B45309; background: #FEF3C7; }
.guide-content .badge-restructure { color: #9333EA; background: #F3E8FF; }
.guide-content .badge-consolidate { color: #0369A1; background: #E0F2FE; }
.guide-content .badge-product-layer { color: #6D28D9; background: #EDE9FE; }
.guide-content .badge-remove      { color: #B91C1C; background: #FEE2E2; }
.guide-content .badge-pass        { color: #1A7A4A; background: #E6F4ED; }
.guide-content .badge-partial     { color: #1448A3; background: #EEF3FB; }
.guide-content .badge-warn        { color: #92400E; background: #FEF3C7; }
.guide-content .badge-fail        { color: #991B1B; background: #FEE2E2; }

/* Code */
.guide-content code {
  font-family: var(--mono);
  font-size: 12px;
  font-weight: 600;
  background: var(--code-bg);
  padding: 1px 4px;
  border-radius: 3px;
  color: var(--code-fg);
}
.guide-content pre {
  background: var(--code-bg);
  border: 0;
  border-radius: 12px;
  padding: 16px 20px;
  overflow-x: auto;
  margin: 12px 0 16px;
  font-size: 12px;
  line-height: 1.6;
}
.guide-content pre code {
  background: none;
  padding: 0;
  font-weight: 400;
  color: var(--code-fg);
}

/* Lists */
.guide-content ul,
.guide-content ol {
  font-size: 14px;
  color: var(--text-2);
  line-height: 1.65;
  margin: 0 0 12px;
  padding-left: 22px;
  max-width: 76ch;
}
.guide-content li { margin-top: 4px; }

/* Entry point to the companion Methodology page */
.guide-methodology-cta { margin-top: 32px; }
</style>
