---
import { url } from '../lib/url';
import Base from '../layouts/Base.astro';
import fs from 'node:fs';
import path from 'node:path';

/**
 * Property Naming Guidelines page.
 *
 * Companion to the Assessment Guide. Reads the standalone
 * `eb-property-naming-guidelines.html` (the editable source-of-truth mirror of
 * the team's Notion doc) and embeds just its <main class="main"> body into the
 * Astro layout, re-skinned via `.guide-content`-scoped CSS.
 *
 * The style block below is a lean subset of the shared guide styling — only the
 * primitives this page actually uses (cover, sections, tables, code, infobox,
 * rule, stat cards, do/don't cards, collapsible catalogs). The phone-frame /
 * spacing-scale / type-specimen visuals from the Screen Design Guide are
 * intentionally omitted — they don't apply here.
 *
 * The standalone header / back-button are stripped; the Astro chrome
 * (breadcrumb, cover, right-side TOC) replaces them.
 */

const HTML_PATH = path.resolve(process.cwd(), '..', 'eb-property-naming-guidelines.html');
const raw = fs.readFileSync(HTML_PATH, 'utf8');

// Right-side "On this page" — order matches the source sections.
const TOC_SECTIONS = [
  { id: 'glance',             label: 'At a Glance' },
  { id: 'property-types',     label: 'Component Property Types' },
  { id: 'variant-props',      label: '1 · Variant Properties' },
  { id: 'boolean-props',      label: '2 · Boolean Properties' },
  { id: 'text-props',         label: '3 · Text Properties' },
  { id: 'slot-props',         label: '4 · Slot Properties' },
  { id: 'values',             label: '5 · Property Values' },
  { id: 'general-guidelines', label: '6 · General Guidelines' },
  { id: 'content-hierarchy',  label: '7 · Content Hierarchy' },
  { id: 'governance',         label: '8 · Property Catalog' },
];

// Extract the inner HTML of <main class="main"> ... </main>.
function extractMainBody(html: string): string {
  const start = html.indexOf('<main class="main">');
  const end = html.indexOf('</main>', start);
  if (start === -1 || end === -1) return '';
  let inner = html.slice(start + '<main class="main">'.length, end);

  // Strip the legacy back-button (Astro's breadcrumb replaces it).
  inner = inner.replace(/<a class="back-btn"[\s\S]*?<\/a>\s*/, '');

  // Strip the surrounding <div class="content-wrap"> open/close — Astro
  // provides its own wrapper.
  inner = inner.replace(/^\s*<div class="content-wrap">/, '');
  inner = inner.replace(/<\/div>\s*<!--\s*\/content-wrap\s*-->\s*$/, '');

  return inner.trim();
}

const guideHtml = extractMainBody(raw);
---
<Base title="Property Naming Guidelines · East Blue">
  <div class="panel active guide-page">
    <div class="panel-layout">
      <div class="content-wrap">
        <nav class="guide-breadcrumb" aria-label="Breadcrumb">
          <a class="back-btn" href={url("/")}>Overview</a>
          <span class="guide-breadcrumb-sep" aria-hidden="true">›</span>
          <span class="guide-breadcrumb-current">Property Naming Guidelines</span>
        </nav>
        <div class="guide-content" set:html={guideHtml} />
      </div>
      <aside class="page-toc" aria-label="On this page">
        <div class="page-toc-label">On this page</div>
        <nav class="page-toc-nav">
          {TOC_SECTIONS.map((s) => (
            <a class="page-toc-link" href={`#${s.id}`} data-toc-target={s.id}>{s.label}</a>
          ))}
        </nav>
      </aside>
    </div>
  </div>
</Base>

<style is:global>
/* ────────────────────────────────────────────────────────────────────
   Property Naming Guidelines — lean subset of the shared guide styling.
   Only the primitives this page uses. All selectors scoped to
   `.guide-content` so nothing leaks. Mirrors the look of the other guides.
   ──────────────────────────────────────────────────────────────────── */

.guide-page { padding: 40px 0 80px; }

/* Cover — override global `.cover { display: none }` */
.guide-content .cover {
  display: block !important;
  padding: 8px 0 32px;
  border-bottom: 1px solid var(--sidebar-border);
  margin-bottom: 36px;
}
.guide-content .cover-eyebrow {
  display: block !important;
  font-size: 12px;
  font-weight: 600;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: #1972F9;
  margin-bottom: 10px;
}
.guide-content .cover-title {
  display: block !important;
  font-family: var(--font-heading);
  font-size: 28px;
  font-weight: 500;
  color: var(--text);
  line-height: 1.2;
  margin-bottom: 8px;
}
.guide-content .cover-subtitle {
  display: block !important;
  font-size: 14px;
  color: var(--muted);
  margin-bottom: 20px;
  line-height: 1.6;
  max-width: 72ch;
}

/* Sections */
.guide-content .page-section { margin-bottom: 48px; }
.guide-content .section-heading {
  font-family: var(--font-heading);
  font-size: 18px;
  font-weight: 600;
  color: var(--text);
  letter-spacing: -0.01em;
  margin-bottom: 6px;
}
.guide-content .section-desc {
  font-size: 14px;
  color: var(--muted);
  margin-bottom: 16px;
  line-height: 1.65;
}
.guide-content .sub-heading {
  font-family: var(--font-heading);
  font-size: 15px;
  font-weight: 600;
  color: var(--text);
  margin-bottom: 10px;
  margin-top: 28px;
  letter-spacing: -0.01em;
}
.guide-content p {
  font-size: 14px;
  color: var(--text-2);
  line-height: 1.65;
  margin-bottom: 12px;
}
.guide-content p:last-child { margin-bottom: 0; }

/* Tables */
.guide-content .table-wrap {
  overflow: hidden;
  border-radius: 12px;
  background: var(--surface);
  border: 1px solid var(--sidebar-border);
  margin-bottom: 20px;
}
.guide-content table {
  width: 100%;
  border-collapse: collapse;
  font-size: 14px;
  margin: 0;
  border: 0;
}
.guide-content thead th {
  background: var(--thead-bg);
  padding: 10px 16px;
  text-align: left;
  font-size: 12px;
  font-weight: 600;
  color: var(--thead-fg);
  letter-spacing: 0.02em;
  white-space: nowrap;
  border-bottom: 0;
}
.guide-content tbody td {
  padding: 11px 16px;
  border-top: 1px solid var(--row-border);
  vertical-align: top;
  color: var(--text-2);
}
.guide-content tbody tr:first-child td { border-top: 0; }
.guide-content td.mono { font-family: var(--mono); font-size: 12px; }
.guide-content td strong, .guide-content tbody td strong { font-weight: 600; color: var(--text); }

/* Code */
.guide-content code {
  font-family: var(--mono);
  font-size: 12px;
  font-weight: 600;
  background: var(--code-bg);
  padding: 1px 4px;
  border-radius: 3px;
  color: var(--code-fg);
}

/* Infobox */
.guide-content .infobox {
  border-radius: 12px;
  padding: 14px 16px;
  font-size: 13px;
  line-height: 1.65;
  margin: 16px 0 0;
  background: var(--accent-light);
  border: 1px solid var(--issue-border);
  color: var(--text-2);
}
.guide-content .infobox strong { color: var(--text); font-weight: 600; }
.guide-content .infobox a { color: var(--accent); font-weight: 600; text-decoration: none; }
.guide-content .infobox a:hover { text-decoration: underline; }

/* Footer */
.guide-content .footer {
  border-top: 1px solid var(--border);
  padding-top: 20px;
  font-size: 12px;
  color: var(--muted);
  text-align: center;
  margin-top: 64px;
}

/* At-a-glance stat cards */
.guide-content .viz-stats { display: grid; grid-template-columns: repeat(4, 1fr); gap: 12px; margin: 8px 0 20px; }
.guide-content .viz-stat { background: var(--accent-light); border-radius: 12px; padding: 16px 12px; text-align: center; }
.guide-content .viz-stat-num { display: block; font-family: var(--font-heading); font-size: 20px; font-weight: 700; color: var(--accent); line-height: 1.1; }
.guide-content .viz-stat-lbl { display: block; font-size: 11px; color: var(--muted); margin-top: 6px; font-weight: 600; }

/* One-line rule highlight */
.guide-content .rule {
  display: flex; align-items: center; gap: 10px;
  background: var(--surface); border: 1px solid var(--row-border); border-left: 3px solid var(--accent);
  border-radius: 8px; padding: 11px 16px; margin: 0 0 16px;
  font-size: 14px; font-weight: 500; color: var(--text);
}
.guide-content .rule code { font-weight: 600; }
.guide-content .rule::before {
  content: "✓"; display: inline-flex; align-items: center; justify-content: center;
  width: 18px; height: 18px; border-radius: 50%; background: var(--accent); color: #fff;
  font-size: 11px; flex-shrink: 0;
}

/* Do / Don't pairs */
.guide-content .viz-dodont { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin: 4px 0 20px; }
.guide-content .dd { border-radius: 12px; padding: 16px; border: 1px solid var(--row-border); }
.guide-content .dd-do   { background: rgba(26,122,74,0.08);  border-color: rgba(26,122,74,0.28); }
.guide-content .dd-dont { background: rgba(185,28,28,0.07); border-color: rgba(185,28,28,0.28); }
.guide-content .dd-tag { font-size: 12px; font-weight: 700; margin-bottom: 10px; }
.guide-content .dd-do .dd-tag   { color: #1A7A4A; }
.guide-content .dd-dont .dd-tag { color: #B91C1C; }
.guide-content .dd-body { font-size: 13px; color: var(--text-2); line-height: 1.9; }
.guide-content .dd-body code { font-weight: 600; }

/* Inline qualifier on a table cell — e.g. "(interaction)" */
.guide-content .viz-sp-val { font-family: var(--mono); font-size: 11px; color: var(--muted); font-weight: 400; }

/* Collapsible reference tables (full boolean / long catalogs) */
.guide-content .guide-details {
  border: 1px solid var(--sidebar-border);
  border-radius: 12px;
  background: var(--surface);
  margin-bottom: 12px;
  overflow: hidden;
}
.guide-content .guide-details > summary {
  cursor: pointer;
  padding: 13px 16px;
  font-size: 14px;
  font-weight: 600;
  color: var(--text);
  list-style: none;
  display: flex;
  align-items: center;
  gap: 8px;
  user-select: none;
}
.guide-content .guide-details > summary::-webkit-details-marker { display: none; }
.guide-content .guide-details > summary::before {
  content: "▸";
  color: var(--accent);
  font-size: 11px;
  transition: transform 0.15s ease;
}
.guide-content .guide-details[open] > summary::before { transform: rotate(90deg); }
.guide-content .guide-details > summary code { font-weight: 600; }
.guide-content .guide-details[open] > summary { border-bottom: 1px solid var(--row-border); }
/* Table inside a details sits flush — drop its own card chrome */
.guide-content .guide-details .table-wrap { border: 0; border-radius: 0; margin-bottom: 0; }

@media (max-width: 640px) {
  .guide-content .viz-stats { grid-template-columns: repeat(2, 1fr); }
  .guide-content .viz-dodont { grid-template-columns: 1fr; }
}
</style>
