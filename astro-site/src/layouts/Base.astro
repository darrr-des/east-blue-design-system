---
import '../styles/global.css';
import Sidebar from '../components/Sidebar.astro';
import SearchModal from '../components/SearchModal.astro';
import AuthGate from '../components/AuthGate.astro';
import { ClientRouter } from 'astro:transitions';
import { url, BASE } from '../lib/url';

interface Props {
  title: string;
  bodyClass?: string;
  activeSlug?: string;
}
const { title, bodyClass = '', activeSlug } = Astro.props;
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <!-- Base path for client scripts — they can't read import.meta.env -->
    <script is:inline define:vars={{ BASE }}>window.__EB_BASE = BASE;</script>
    <ClientRouter />
  </head>
  <body class={bodyClass}>
    <AuthGate />
    {/* Phone-width navigation: the sidebar slides in from this bar (global.css › Mobile Top Bar). */}
    <header class="topbar" transition:persist>
      <button type="button" class="topbar-hamburger" aria-label="Open navigation" aria-expanded="false" aria-controls="eb-sidebar" onclick="toggleSidebar(this)">
        <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M3 5h14M3 10h14M3 15h14" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
      </button>
      <span class="topbar-title">East Blue</span>
    </header>
    <Sidebar activeSlug={activeSlug} transition:persist />
    <main class="main" transition:animate="fade">
      <slot />
    </main>
    <SearchModal transition:persist />
    <script src={url('/scripts/assessment.js')} is:inline></script>
  </body>
</html>
