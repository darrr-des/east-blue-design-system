---
import '../styles/global.css';
import Sidebar from '../components/Sidebar.astro';
// TEMP: client-side auth gate stashed for password-protect handover.
// Re-enable by uncommenting the import below + the <AuthGate /> tag in <body>.
// import AuthGate from '../components/AuthGate.astro';
import { ClientRouter } from 'astro:transitions';

interface Props {
  title: string;
  bodyClass?: string;
  activeSlug?: string;
}
const { title, bodyClass = '', activeSlug } = Astro.props;
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <ClientRouter />
  </head>
  <body class={bodyClass}>
    {/* TEMP: AuthGate stashed for password-protect handover. Re-enable by uncommenting. */}
    {/* <AuthGate /> */}
    <Sidebar activeSlug={activeSlug} transition:persist />
    <main class="main" transition:animate="fade">
      <slot />
    </main>
    <script src="/scripts/assessment.js" is:inline></script>
  </body>
</html>
