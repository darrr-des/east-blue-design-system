---
import '../styles/global.css';
import Sidebar from '../components/Sidebar.astro';
import SearchModal from '../components/SearchModal.astro';
import AuthGate from '../components/AuthGate.astro';
import { ClientRouter } from 'astro:transitions';

interface Props {
  title: string;
  bodyClass?: string;
  activeSlug?: string;
}
const { title, bodyClass = '', activeSlug } = Astro.props;
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <ClientRouter />
  </head>
  <body class={bodyClass}>
    <AuthGate />
    <Sidebar activeSlug={activeSlug} transition:persist />
    <main class="main" transition:animate="fade">
      <slot />
    </main>
    <SearchModal />
    <script src="/scripts/assessment.js" is:inline></script>
  </body>
</html>
