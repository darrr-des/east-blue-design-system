  "overview": {
    "inContextNote": "The Footer sits at the bottom of lending/savings/investment flows — carrying regulatory disclosures, partner attribution, and a link to more information on the Help Center.",
    "inContextHtml": "",
    "inContextImage": "",
    "inContextAlt": "",
    "livePreviewHtml": "<div class=\"demo-layout\"><div class=\"demo-preview\" id=\"footer-demo-preview\"><svg class=\"eb-preview eb-preview-ft\" width=\"360\" height=\"150\" viewBox=\"0 0 360 150\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\"><rect width=\"360\" height=\"150\" fill=\"#FFFFFF\"/><foreignObject x=\"24\" y=\"24\" width=\"312\" height=\"54\"><div xmlns=\"http://www.w3.org/1999/xhtml\" class=\"eb-preview-ft__text\">I acknowledge receipt of this statement prior to the consummation of the credit transaction by availing of this loan.</div></foreignObject><rect x=\"86\" y=\"94\" width=\"188\" height=\"32\" rx=\"2\" fill=\"#EEF2F9\" stroke=\"#C2CFE5\" stroke-dasharray=\"3 3\"/><text class=\"ft-placeholder\" x=\"180\" y=\"110\" font-size=\"9\" fill=\"#C2CFE5\" text-anchor=\"middle\" dominant-baseline=\"central\">raster logo 188 × 32</text></svg></div><div class=\"demo-figma-panel\"><div class=\"demo-panel-section\"><div class=\"demo-panel-heading\">Properties</div><div class=\"demo-panel-row\"><span class=\"demo-panel-label\">Alignment</span><select id=\"ft-ctrl-alignment\" class=\"demo-panel-select\" onchange=\"_footerUpdate()\"><option value=\"left\" selected=\"\">Left</option><option value=\"center\">Center</option></select></div><div class=\"demo-panel-row\"><span class=\"demo-panel-label\">LogoType</span><select id=\"ft-ctrl-logotype\" class=\"demo-panel-select\" onchange=\"_footerUpdate()\"><option value=\"none\">None</option><option value=\"single\">Single</option><option value=\"group\" selected=\"\">Group</option></select></div><div class=\"demo-panel-row\"><span class=\"demo-panel-label\">Label</span><select id=\"ft-ctrl-label\" class=\"demo-panel-select\" onchange=\"_footerUpdate()\"><option value=\"false\" selected=\"\">False</option><option value=\"true\">True</option></select></div><div class=\"demo-panel-row\"><span class=\"demo-panel-label\">Description</span><select id=\"ft-ctrl-description\" class=\"demo-panel-select\" onchange=\"_footerUpdate()\"><option value=\"none\">None</option><option value=\"default\" selected=\"\">Default</option><option value=\"link\">Link</option></select></div></div></div></div>",
