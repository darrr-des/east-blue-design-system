    "verdict": {
      "kind": "keep",
      "title": "Keep — one Type setting and two slots",
      "text": "<code>Type</code> (Success, Loading, Error, Neutral) sets the title colour; <code>⤷ IllustrationSlot</code> and <code>⤷ BodySlot</code> take the visual and the body, and three booleans show the body, download and reference number."
    },
