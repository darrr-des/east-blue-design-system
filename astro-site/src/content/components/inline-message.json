        "subheading": "Usage",
        "swift": "<code><span class=\"syn-cmt\">// Success with body content + reference</span>\n<span class=\"syn-type\">EBInlineMessage</span><span class=\"syn-punc\">(</span>\n    <span class=\"syn-param\">title</span>: <span class=\"syn-str\">\"Payment Successful\"</span>,\n    <span class=\"syn-param\">description</span>: <span class=\"syn-str\">\"Your transfer of ₱500 is complete.\"</span>,\n    <span class=\"syn-param\">referenceNumber</span>: <span class=\"syn-str\">\"1234567890\"</span>\n<span class=\"syn-punc\">)</span> <span class=\"syn-punc\">{</span>\n    <span class=\"syn-type\">EBListItem</span><span class=\"syn-punc\">(</span><span class=\"syn-str\">\"Send amount: ₱500\"</span><span class=\"syn-punc\">)</span> <span class=\"syn-punc\">{</span> <span class=\"syn-type\">EBListMarker</span><span class=\"syn-punc\">(</span><span class=\"syn-param\">variant</span>: <span class=\"syn-dot\">.check</span><span class=\"syn-punc\">)</span> <span class=\"syn-punc\">}</span>\n    <span class=\"syn-type\">EBListItem</span><span class=\"syn-punc\">(</span><span class=\"syn-str\">\"Fee: ₱0\"</span><span class=\"syn-punc\">)</span> <span class=\"syn-punc\">{</span> <span class=\"syn-type\">EBListMarker</span><span class=\"syn-punc\">(</span><span class=\"syn-param\">variant</span>: <span class=\"syn-dot\">.check</span><span class=\"syn-punc\">)</span> <span class=\"syn-punc\">}</span>\n<span class=\"syn-punc\">}</span>\n.<span class=\"syn-fn\">ebType</span><span class=\"syn-punc\">(</span><span class=\"syn-dot\">.success</span><span class=\"syn-punc\">)</span>\n\n<span class=\"syn-cmt\">// Loading (Lottie spinner)</span>\n<span class=\"syn-type\">EBInlineMessage</span><span class=\"syn-punc\">(</span>\n    <span class=\"syn-param\">title</span>: <span class=\"syn-str\">\"Processing your transaction\"</span>,\n    <span class=\"syn-param\">description</span>: <span class=\"syn-str\">\"This usually takes a few seconds.\"</span>\n<span class=\"syn-punc\">)</span>\n.<span class=\"syn-fn\">ebType</span><span class=\"syn-punc\">(</span><span class=\"syn-dot\">.loading</span><span class=\"syn-punc\">)</span>\n\n<span class=\"syn-cmt\">// Error</span>\n<span class=\"syn-type\">EBInlineMessage</span><span class=\"syn-punc\">(</span>\n    <span class=\"syn-param\">title</span>: <span class=\"syn-str\">\"Transfer Failed\"</span>,\n    <span class=\"syn-param\">description</span>: <span class=\"syn-str\">\"Insufficient balance. Please top up and try again.\"</span>\n<span class=\"syn-punc\">)</span>\n.<span class=\"syn-fn\">ebType</span><span class=\"syn-punc\">(</span><span class=\"syn-dot\">.error</span><span class=\"syn-punc\">)</span></code>",
