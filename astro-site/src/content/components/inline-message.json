  "overview": {
    "inContextNote": "How the inline message appears in real product screens — “We’re doing a few more checks!” on GStocks Global, and “Your Sell Order is being processed” on a Receipt.",
    "inContextHtml": "<img class=\"ctx-img\" src=\"/assets/previews/inline-message-in-context.png\" alt=\"Inline Message shown on two GCash screens: a gold hourglass with the yellow title We’re doing a few more checks! and a download icon on GStocks Global, and a blue check with the blue title Your Sell Order is being processed above an If you will be there to receive: list on a Receipt\" >",
    "inContextImage": "",
    "inContextAlt": "",
    "livePreviewHtml": "<div class=\"demo-layout\"><div class=\"demo-preview\" id=\"im-demo-preview\"></div><div class=\"demo-figma-panel\"><div class=\"demo-panel-section\"><div class=\"demo-panel-heading\">Properties</div><div class=\"demo-panel-row\"><span class=\"demo-panel-label\">hasReferenceNumber</span><label class=\"demo-panel-toggle is-on\"><input type=\"checkbox\" id=\"im-demo-ref\" checked onchange=\"this.parentElement.classList.toggle(&#39;is-on&#39;,this.checked);updateInlineMessageDemo()\"/><span class=\"demo-panel-toggle__track\"><span class=\"demo-panel-toggle__thumb\"></span></span></label></div><div class=\"demo-panel-row\"><span class=\"demo-panel-label\">hasBodyContent</span><label class=\"demo-panel-toggle is-on\"><input type=\"checkbox\" id=\"im-demo-body\" checked onchange=\"this.parentElement.classList.toggle(&#39;is-on&#39;,this.checked);updateInlineMessageDemo()\"/><span class=\"demo-panel-toggle__track\"><span class=\"demo-panel-toggle__thumb\"></span></span></label></div><div class=\"demo-panel-row\"><span class=\"demo-panel-label\">hasDownload</span><label class=\"demo-panel-toggle is-on\"><input type=\"checkbox\" id=\"im-demo-download\" checked onchange=\"this.parentElement.classList.toggle(&#39;is-on&#39;,this.checked);updateInlineMessageDemo()\"/><span class=\"demo-panel-toggle__track\"><span class=\"demo-panel-toggle__thumb\"></span></span></label></div><div class=\"demo-panel-row\"><span class=\"demo-panel-label\">Type</span><select class=\"demo-panel-select\" id=\"im-demo-type\" onchange=\"updateInlineMessageDemo()\"><option value=\"Success\" selected>Success</option><option value=\"Loading\">Loading</option><option value=\"Error\">Error</option><option value=\"Neutral\">Neutral</option></select></div></div></div></div>",
    "traits": [
      {
        "name": "Reusable",
        "rating": "pass",
        "note": "Covers confirm, processing, and error outcomes for transactions, logins, KYC, and any multi-step flow with a final status surface."
      },
      {
        "name": "Self-contained",
        "rating": "pass",
        "note": "Carries its own radius, borders and typography, all token-bound. The illustration is a swappable <code>⤷ IllustrationSlot</code> at a single 106px size."
      },
      {
        "name": "Consistent",
        "rating": "pass",
        "note": "A single <code>Type</code> setting (Success / Loading / Error / Neutral), Title Case, and camelCase booleans (<code>hasReferenceNumber</code>, <code>hasBodyContent</code>, <code>hasDownload</code>)."
      },
      {
        "name": "Composable",
        "rating": "pass",
        "note": "Two Figma slots — <code>⤷ IllustrationSlot</code> for the visual and <code>⤷ BodySlot</code> for custom content (transaction breakdowns, beneficiary lists), so consumers compose their own body rather than being locked to a fixed List."
      }
    ],
