  "changelog": [
    {
      "version": "1.0.1",
      "date": "September 2026",
      "kind": "patch",
      "kindLabel": "Patch",
      "header": "Documentation backfill · node 26416:18421",
      "rows": [
        {
          "body": "<strong>Resolved issues recorded.</strong> 6 resolved issues on the Overview tab had no changelog row: v2.0: Body content exposed as a real Figma slot — Body Container — so consumers compose their own List Items, tables, or custom content instead of being locked to a fixed List; v2.0: Neutral type added — the enum now covers Success / Loading / Error / Neutral, so informational messages no longer have to borrow a charged intent; v2.0: bg-subtle alpha token resolved — the background no longer composites against whatever sits behind it; v2.0: Illustration is now a swappable Illustration Container slot rather than a baked-in raster, and the asset itself is resolved; v2.1: Redundant Illustration Size axis removed — the two 106 / 64 sizes collapsed to a single 106px Illustration Container, leaving a clean single-axis Type enum (8 variants → 4); v2.1: Slot names de-duplicated — Illustration Container Slot / Body Container Slot → Illustration Container / Body Container (dropping the doubled \\\"Container Slot\\\"), and the size property was aligned from Asset Size to the same Illustration term so the prop and slot agree.",
          "delta": {
            "kind": "resolved",
            "label": "Docs"
          }
        }
      ]
    },
