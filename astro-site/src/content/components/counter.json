  "overview": {
    "inContextNote": "How the counter appears in real product screens — a limit counter (10 / 10) beside the Send to list in Express Send, and a count (2) beside the People section when splitting a bill.",
    "inContextHtml": "<img class=\"ctx-img\" src=\"/assets/previews/counter-in-context.png\" alt=\"Counter component shown on two GCash screens: a 10 / 10 limit counter next to Send to on the Express Send recipient list, and a 2 counter next to People on a split-bill screen\" >",
    "inContextImage": "",
    "inContextAlt": "",
    "livePreviewHtml": "<div class=\"demo-layout\"><div class=\"demo-preview\" id=\"counter-demo-preview\"><span class=\"eb-preview eb-preview-counter eb-preview-counter--limit\"><span class=\"eb-preview-counter__count\">0</span><span class=\"eb-preview-counter__sep\">/</span><span class=\"eb-preview-counter__limit\">10</span></span></div><div class=\"demo-figma-panel\"><div class=\"demo-panel-section\"><div class=\"demo-panel-heading\">Properties</div><div class=\"demo-panel-row\"><span class=\"demo-panel-label\">State</span><select id=\"counter-ctrl-state\" class=\"demo-panel-select\" onchange=\"_counterUpdate()\"><option value=\"default\" selected=\"\">Default</option><option value=\"disabled\">Disabled</option></select></div><div class=\"demo-panel-row\"><span class=\"demo-panel-label\">hasLimit</span><select id=\"counter-ctrl-haslimit\" class=\"demo-panel-select\" onchange=\"_counterUpdate()\"><option value=\"true\" selected=\"\">True</option><option value=\"false\">False</option></select></div></div><div class=\"demo-panel-section\"><div class=\"demo-panel-heading\">Content</div><div class=\"demo-panel-row\"><span class=\"demo-panel-label\">Count</span><input type=\"text\" id=\"counter-ctrl-count\" class=\"demo-panel-select demo-panel-input\" value=\"0\" oninput=\"_counterUpdate()\"></div><div class=\"demo-panel-row\"><span class=\"demo-panel-label\">Limit</span><input type=\"text\" id=\"counter-ctrl-limit\" class=\"demo-panel-select demo-panel-input\" value=\"10\" oninput=\"_counterUpdate()\"></div><div class=\"demo-panel-row\"><span class=\"demo-panel-label\">maxDisplay</span><input type=\"text\" id=\"counter-ctrl-max\" class=\"demo-panel-select demo-panel-input\" value=\"99\" oninput=\"_counterUpdate()\"></div></div></div></div>",
