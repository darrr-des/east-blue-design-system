    "usageGuidelines": [
      {
        "doText": "Use Brand at the top of a transaction detail screen; Default when the hero sits below a Brand app bar.",
        "dontText": "Don’t stack a Brand hero under a Brand app bar — two blues merge."
      },
      {
        "doText": "Keep the Title to one line; the 26 px line-height is sized for one.",
        "dontText": "Don’t put the amount in the Title — that is the Value row."
      },
      {
        "doText": "Use the single Label / Value row for the one fact the user came for.",
        "dontText": "Don’t add rows — the set builds one SenderDetails row by design (v2.x)."
      }
    ],
