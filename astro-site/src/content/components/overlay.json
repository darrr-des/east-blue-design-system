      "kind": "keep",
      "title": "Keep — all findings resolved",
      "text": "All four DS Health traits pass and nothing is open. Three strength tiers — Weak 24%, Default 40%, Strong 56% — each bind their own semantic token, and the 360×800 default scales with its instance."
    },
    "navGroup": "",
    "navIconSvg": ""
