---
/**
 * SearchModal — global, keyboard-accessible search modal.
 *
 * Opens when any element with [data-action="open-search"] is clicked
 * (or when document fires the custom event `eb:open-search`).
 *
 * Behaviours
 *   • Centered modal card over a scrim+blur backdrop
 *   • Empty state: rotating placeholder ("Are you looking for X?")
 *   • Typing: live filtered results from componentManifest + static pages
 *   • ↑/↓ to move highlight, Enter to navigate, ESC to close
 *
 * Data is rendered into <script type="application/json"> at build time so
 * the runtime script can read it without a fetch.
 */

import { componentManifest } from '../data/components/_index';

type SearchEntry = {
  name: string;
  path: string;
  breadcrumb: string;
};

// Static top-level pages — point at the prototype routes so the prototype
// nav (Sidebar + Search + per-card links) all flow into each other.
const PAGES: SearchEntry[] = [
  { name: 'Overview',   path: '/sandbox/overview-redesign',   breadcrumb: '/sandbox' },
  { name: 'Components', path: '/sandbox/components-redesign', breadcrumb: '/sandbox' },
  { name: 'Guide',      path: '/eb-ds-assessment-guide',      breadcrumb: '/' },
];

// Components: each manifest entry → an entry. If it has navGroup, breadcrumb
// shows /components/<group> so "Action List - with Counter" reads as a child
// of the Action List group (matches the user's spec).
const COMPONENTS: SearchEntry[] = componentManifest.map((c) => ({
  name: c.name,
  path: `/components/${c.slug}`,
  breadcrumb: c.navGroup
    ? `/components/${c.navGroup.toLowerCase()}`
    : '/components',
}));

const SEARCH_DATA: SearchEntry[] = [...PAGES, ...COMPONENTS];

// Words rotated through the placeholder.
const PLACEHOLDER_WORDS = ['Components', 'Colors', 'Fonts', 'Icons', 'Guide'];
---

<div class="sm-overlay" data-search-modal hidden>
  <div class="sm-backdrop" data-search-close></div>

  <div class="sm-stack" role="dialog" aria-modal="true" aria-label="Search">
    {/* Pill-shaped input bar */}
    <div class="sm-bar">
      {/* lucide-react ChevronsRight glyph (»). Two stacked right chevrons. */}
      <svg class="sm-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="m6 17 5-5-5-5" />
        <path d="m13 17 5-5-5-5" />
      </svg>
      <div class="sm-input-wrap">
        {/* Native placeholder is a single space so :placeholder-shown stays valid */}
        <input
          type="text"
          class="sm-input"
          autocomplete="off"
          spellcheck="false"
          autocapitalize="off"
          aria-label="Search"
          placeholder=" "
        />
        <div class="sm-ghost" aria-hidden="true">
          <span class="sm-ghost-prefix">Are you looking for</span>
          <span class="sm-ghost-rotator">
            <span class="sm-ghost-word">Components?</span>
          </span>
        </div>
      </div>
      <kbd class="sm-esc">esc</kbd>
    </div>

    {/* Results panel — only renders when there are matches */}
    <div class="sm-panel" hidden>
      <ul class="sm-results" role="listbox" aria-label="Search results"></ul>
    </div>
  </div>
</div>

{/* Build-time data injected for the runtime script */}
<script type="application/json" data-search-data set:html={JSON.stringify(SEARCH_DATA)}></script>
<script type="application/json" data-search-words set:html={JSON.stringify(PLACEHOLDER_WORDS)}></script>

<script is:inline>
  (() => {
    const overlay = document.querySelector('[data-search-modal]');
    if (!overlay) return;
    const dataEl  = document.querySelector('[data-search-data]');
    const wordsEl = document.querySelector('[data-search-words]');
    const data  = JSON.parse((dataEl  && dataEl.textContent)  || '[]');
    const words = JSON.parse((wordsEl && wordsEl.textContent) || '[]');

    const input    = overlay.querySelector('.sm-input');
    const ghost    = overlay.querySelector('.sm-ghost');
    const word     = overlay.querySelector('.sm-ghost-word');
    const panel    = overlay.querySelector('.sm-panel');
    const results  = overlay.querySelector('.sm-results');
    const closeEls = overlay.querySelectorAll('[data-search-close]');

    let rotateTimer = null;
    let wordIdx = 0;
    let activeIdx = 0;
    let lastResults = [];
    let lastFocus = null;

    /* Mark every open-search trigger so it can show an active state. */
    function setTriggerState(isOpen) {
      document.querySelectorAll('[data-action="open-search"]').forEach((el) => {
        if (isOpen) el.setAttribute('data-search-open', '');
        else el.removeAttribute('data-search-open');
      });
    }

    function open() {
      lastFocus = document.activeElement;
      overlay.removeAttribute('hidden');
      document.body.classList.add('sm-open');
      // Force reflow so the transition fires
      void overlay.offsetWidth;
      overlay.classList.add('is-visible');
      input.focus();
      input.value = '';
      hidePanel();
      startRotation();
      setTriggerState(true);
    }

    function close() {
      overlay.classList.remove('is-visible');
      stopRotation();
      setTriggerState(false);
      window.setTimeout(() => {
        overlay.setAttribute('hidden', '');
        document.body.classList.remove('sm-open');
        input.value = '';
        results.innerHTML = '';
        hidePanel();
        if (lastFocus && typeof lastFocus.focus === 'function') {
          lastFocus.focus();
        }
      }, 180);
    }

    function hidePanel() { panel.setAttribute('hidden', ''); }
    function showPanel() { panel.removeAttribute('hidden'); }

    // ── Scramble animation ──────────────────────────────────────────────
    // Each character starts on the previous word, ticks through random
    // glyphs from CHARS for a randomised "scrambling" window, then locks to
    // the target character. Different chars settle at slightly different
    // frames → wave-like resolve effect.
    const SCRAMBLE_CHARS = '!<>-_\\/[]{}—=+*^?#@&%$';
    let scrambleRaf = 0;
    function scrambleTo(fromText, toText) {
      cancelAnimationFrame(scrambleRaf);
      const len = Math.max(fromText.length, toText.length);
      const queue = [];
      for (let i = 0; i < len; i++) {
        queue.push({
          from: fromText[i] || '',
          to:   toText[i]   || '',
          start: Math.floor(Math.random() * 24),
          end:   Math.floor(Math.random() * 24) + 24,
          char: '',
        });
      }
      let frame = 0;
      function step() {
        let out = '';
        let done = 0;
        for (let i = 0; i < queue.length; i++) {
          const q = queue[i];
          if (frame >= q.end) {
            done++;
            out += q.to;
          } else if (frame >= q.start) {
            if (!q.char || Math.random() < 0.28) {
              q.char = SCRAMBLE_CHARS[Math.floor(Math.random() * SCRAMBLE_CHARS.length)];
            }
            out += q.char;
          } else {
            out += q.from;
          }
        }
        word.textContent = out;
        if (done < queue.length) {
          frame++;
          scrambleRaf = requestAnimationFrame(step);
        }
      }
      step();
    }

    function startRotation() {
      stopRotation();
      word.textContent = words[wordIdx] + '?';
      rotateTimer = window.setInterval(() => {
        if (input.value) return;
        const fromText = word.textContent || '';
        wordIdx = (wordIdx + 1) % words.length;
        const toText = words[wordIdx] + '?';
        scrambleTo(fromText, toText);
      }, 2400);
    }

    function stopRotation() {
      if (rotateTimer) {
        window.clearInterval(rotateTimer);
        rotateTimer = null;
      }
      cancelAnimationFrame(scrambleRaf);
    }

    // Score-based fuzzy-ish match: exact > prefix > contains.
    function rank(query) {
      const q = query.trim().toLowerCase();
      if (!q) return [];
      const out = [];
      for (let i = 0; i < data.length; i++) {
        const e = data[i];
        const n = e.name.toLowerCase();
        let s = 0;
        if (n === q) s = 1000;
        else if (n.startsWith(q)) s = 500 - n.length;
        else if (n.includes(q)) s = 100 - n.length;
        if (s > 0) out.push({ e, s });
      }
      out.sort((a, b) => b.s - a.s || a.e.name.localeCompare(b.e.name));
      return out.slice(0, 10).map((m) => m.e);
    }

    function renderResults(list) {
      lastResults = list;
      activeIdx = 0;
      if (!list.length) {
        results.innerHTML = '<li class="sm-no-match" role="option">No matches.</li>';
        showPanel();
        return;
      }
      let html = '';
      for (let i = 0; i < list.length; i++) {
        const r = list[i];
        const cls = 'sm-result' + (i === 0 ? ' is-active' : '');
        html += '<li class="' + cls + '" role="option" data-idx="' + i + '">'
              +   '<a href="' + r.path + '">'
              +     '<span class="sm-result-name">' + escapeHtml(r.name) + '</span>'
              +     '<span class="sm-result-path">' + escapeHtml(r.breadcrumb) + '</span>'
              +   '</a>'
              + '</li>';
      }
      results.innerHTML = html;
      showPanel();
    }

    function setActive(idx) {
      const items = results.querySelectorAll('.sm-result');
      if (!items.length) return;
      const wrapped = ((idx % items.length) + items.length) % items.length;
      items.forEach((el, i) => el.classList.toggle('is-active', i === wrapped));
      activeIdx = wrapped;
      const active = items[wrapped];
      if (active) active.scrollIntoView({ block: 'nearest' });
    }

    function escapeHtml(s) {
      return String(s)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#39;');
    }

    // ── Listeners ────────────────────────────────────────────────────────
    input.addEventListener('input', () => {
      // Hide ghost as soon as the user types
      ghost.style.opacity = input.value ? '0' : '';
      if (!input.value) {
        results.innerHTML = '';
        hidePanel();
        return;
      }
      renderResults(rank(input.value));
    });

    input.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowDown') { e.preventDefault(); setActive(activeIdx + 1); return; }
      if (e.key === 'ArrowUp')   { e.preventDefault(); setActive(activeIdx - 1); return; }
      if (e.key === 'Enter') {
        const items = results.querySelectorAll('.sm-result');
        const active = items[activeIdx];
        const a = active && active.querySelector('a');
        if (a) {
          e.preventDefault();
          window.location.href = a.getAttribute('href');
        }
      }
    });

    // Hover highlights the row under cursor (matches the keyboard active state)
    results.addEventListener('mousemove', (e) => {
      const li = e.target && e.target.closest && e.target.closest('.sm-result');
      if (!li) return;
      const idx = Number(li.getAttribute('data-idx'));
      if (!isNaN(idx)) setActive(idx);
    });

    closeEls.forEach((el) => el.addEventListener('click', close));

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !overlay.hasAttribute('hidden')) {
        e.preventDefault();
        close();
        return;
      }
      /* ⌘K / Ctrl+K — open from anywhere on the site. Don't fire when
         the user is already typing in an input, textarea, or
         contenteditable element. */
      if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') {
        const tag = document.activeElement && document.activeElement.tagName;
        const editable = document.activeElement && document.activeElement.isContentEditable;
        const inField = tag === 'INPUT' || tag === 'TEXTAREA' || editable;
        if (inField && document.activeElement !== input) return;
        e.preventDefault();
        if (overlay.hasAttribute('hidden')) open();
        else close();
      }
    });

    // Click on any [data-action="open-search"] opens the modal.
    // Also support the `eb:open-search` custom event for code-driven opens.
    document.addEventListener('click', (e) => {
      const trigger = e.target && e.target.closest && e.target.closest('[data-action="open-search"]');
      if (!trigger) return;
      e.preventDefault();
      open();
    });
    document.addEventListener('eb:open-search', open);
  })();
</script>

<style is:global>
  /* ────────────────────────────────────────────────────────────────────
     Search modal
     ──────────────────────────────────────────────────────────────────── */
  body.sm-open { overflow: hidden; }

  .sm-overlay {
    position: fixed;
    inset: 0;
    z-index: 1000;
    display: flex;
    align-items: flex-start;
    justify-content: center;
    padding: 96px 24px 24px;
    opacity: 0;
    transition: opacity 0.32s ease;
  }
  .sm-overlay.is-visible { opacity: 1; }
  .sm-overlay[hidden]    { display: none; }

  .sm-backdrop {
    position: absolute;
    inset: 0;
    /* #020E22 at 40% opacity — no blur per spec */
    background: rgba(2, 14, 34, 0.40);
    cursor: pointer;
  }

  .sm-stack {
    position: relative;
    width: min(560px, calc(100% - 48px));
    display: flex;
    flex-direction: column;
    gap: 10px;
    font-family: 'HeyMeow Rnd', system-ui, sans-serif;
  }

  /* Pill-shaped input bar — matches the sidebar trigger's 999px radius
     so the trigger and the active modal share the same shape language. */
  .sm-bar {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    gap: 14px;
    height: 56px;
    padding: 0 20px;
    background: #ffffff;
    border: 1px solid #e5ebf4;
    border-radius: 999px;
    box-shadow: 0 12px 32px rgba(2, 14, 34, 0.16),
                0 0 0 1px rgba(10, 39, 87, 0.04);
    transform: translateY(-12px) scale(0.985);
    transition: transform 0.5s cubic-bezier(0.34, 1.56, 0.64, 1);
  }
  .sm-overlay.is-visible .sm-bar { transform: translateY(0) scale(1); }

  .sm-icon { color: #6780a9; flex-shrink: 0; }

  .sm-input-wrap {
    position: relative;
    flex: 1;
    min-width: 0;
  }
  .sm-input,
  .sm-ghost {
    font-family: inherit;
    font-size: 16px;
    font-weight: 400;
    line-height: 1;
  }
  .sm-input {
    width: 100%;
    height: 24px;
    background: transparent;
    border: 0;
    outline: 0;
    padding: 0;
    color: #0a2757;
  }
  .sm-input::placeholder { color: transparent; }

  .sm-ghost {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    gap: 5px;
    color: #6780a9;
    pointer-events: none;
    white-space: nowrap;
    transition: opacity 0.15s ease;
  }
  /* Hide the ghost as soon as the input has any text */
  .sm-input:not(:placeholder-shown) ~ .sm-ghost { opacity: 0; }

  .sm-ghost-prefix { color: #6780a9; }
  /* Rotating word inherits the muted prefix color (#6780A9) — no contrast
     bump anymore. Weight stays at 500 so it still reads as a label. */
  .sm-ghost-rotator {
    position: relative;
    display: inline-block;
    color: #6780a9;
    font-weight: 500;
  }
  /* Scramble animation — JS swaps the textContent character-by-character.
     font-variant-numeric: tabular-nums + a slight letter-spacing nudge
     keeps the width stable enough that the layout doesn't jitter while the
     scramble is in flight. */
  .sm-ghost-word {
    display: inline-block;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0;
    min-width: 8ch;
  }

  .sm-esc {
    flex-shrink: 0;
    font-family: 'Fira Code', 'SF Mono', Monaco, monospace;
    font-size: 11px;
    font-weight: 500;
    color: #6780a9;
    background: #f6f9fd;
    border: 1px solid #e5ebf4;
    border-radius: 5px;
    padding: 2px 6px;
    line-height: 1.2;
  }

  /* Results panel — same elevation as the bar (matching shadow + z-index)
     so they read as siblings at the same depth, not stacked layers. */
  .sm-panel {
    position: relative;
    z-index: 1;
    background: #ffffff;
    border: 1px solid #e5ebf4;
    border-radius: 16px;
    box-shadow: 0 12px 32px rgba(2, 14, 34, 0.16),
                0 0 0 1px rgba(10, 39, 87, 0.04);
    overflow: hidden;
    transform-origin: top center;
    animation: smPanelIn 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
  }
  .sm-panel[hidden] { display: none; }
  @keyframes smPanelIn {
    from { opacity: 0; transform: translateY(-6px) scale(0.97); }
    to   { opacity: 1; transform: translateY(0) scale(1); }
  }

  .sm-results {
    list-style: none;
    margin: 0;
    padding: 8px;
    max-height: 60vh;
    overflow-y: auto;
    scrollbar-width: thin;
  }
  .sm-results::-webkit-scrollbar       { width: 6px; }
  .sm-results::-webkit-scrollbar-thumb { background: rgba(103, 128, 169, 0.25); border-radius: 3px; }

  .sm-result { margin: 0; }
  .sm-result a {
    display: block;
    padding: 10px 12px;
    border-radius: 8px;
    color: inherit;
    text-decoration: none;
    transition: background 0.12s ease;
  }
  .sm-result.is-active a { background: #f0f5fc; }

  .sm-result-name {
    display: block;
    font-size: 16px;
    font-weight: 500;
    color: #0a2757;
    line-height: 1.3;
  }
  .sm-result-path {
    display: block;
    margin-top: 4px;
    font-family: 'Fira Code', 'SF Mono', Monaco, monospace;
    font-size: 12px;
    color: #6780a9;
  }

  .sm-no-match {
    list-style: none;
    padding: 14px 16px;
    font-size: 14px;
    color: #6780a9;
    text-align: center;
  }

  @media (max-width: 600px) {
    .sm-overlay { padding: 56px 16px 16px; }
    .sm-bar     { height: 52px; padding: 0 16px; }
  }
</style>
