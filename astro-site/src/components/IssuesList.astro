---
import { withBase } from '../lib/url';
import type { IssueItem } from '../data/types';
interface Props { items: IssueItem[]; variant?: 'open' | 'resolved'; }
const { items, variant = 'resolved' } = Astro.props;
---
<ul class={`resolved-list issues-${variant}`}>
  {items.map((item) => (
    <li>
      <span>
        {item.headline && <Fragment set:html={`<strong>${item.headline}</strong> `} />}
        <Fragment set:html={withBase(item.body)} />
        {item.tag && (
          <span class={`tag-open tag-${item.tag.criterion.toLowerCase()}`}>{item.tag.label}</span>
        )}
      </span>
    </li>
  ))}
</ul>
