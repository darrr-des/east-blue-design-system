---
import type { ColorsTable as ColorsTableType } from '../data/types';
interface Props { table: ColorsTableType; }
const { table } = Astro.props;

/* Pull a renderable swatch color out of a value string.
   Accepts:
     - "#FFFFFF"                 → "#FFFFFF"
     - "#020E22 @ 56%"           → rgba(2,14,34,0.56)
     - "#FFFFFF @ 80%"           → rgba(255,255,255,0.80)
     - "transparent"             → "transparent" (renders as checkerboard)
     - "Image only", "–", "—"    → null (no swatch)
   Returns the css color string OR null if nothing renderable. */
function pickSwatch(value: string): string | null {
  if (!value) return null;
  const trimmed = value.trim();
  if (trimmed === '–' || trimmed === '—' || trimmed === '-') return null;
  if (/^transparent$/i.test(trimmed)) return 'transparent';
  const hexMatch = trimmed.match(/#([0-9a-f]{3,8})\b/i);
  if (!hexMatch) return null;
  const hex = hexMatch[0];
  // Detect "@ NN%" suffix and combine with the hex.
  const pct = trimmed.match(/@\s*(\d{1,3})\s*%/);
  if (pct) {
    const a = Math.max(0, Math.min(100, Number(pct[1]))) / 100;
    const cleaned = hex.replace('#', '');
    const norm = cleaned.length === 3
      ? cleaned.split('').map((c) => c + c).join('')
      : cleaned.slice(0, 6);
    const r = parseInt(norm.slice(0, 2), 16);
    const g = parseInt(norm.slice(2, 4), 16);
    const b = parseInt(norm.slice(4, 6), 16);
    return `rgba(${r}, ${g}, ${b}, ${a})`;
  }
  return hex;
}
---
<div class="style-colors">
  <div class="style-colors-title">{table.title}</div>
  {table.description && <p class="style-colors-desc" set:html={table.description} />}
  <div class="table-wrap">
    <table>
      <thead>
        <tr>
          <th>Role</th>
          <th>Token</th>
          {table.columns.map((c) => <th>{c}</th>)}
        </tr>
      </thead>
      <tbody>
        {table.rows.map((r) => (
          <tr>
            <td class="muted">{r.role}</td>
            <td class="mono">{r.token}</td>
            {r.values.map((v) => {
              const swatch = pickSwatch(v);
              return (
                <td class="mono">
                  <span class="cs-cell">
                    {swatch !== null && (
                      <span
                        class={`cs-swatch${swatch === 'transparent' ? ' is-transparent' : ''}`}
                        style={swatch === 'transparent' ? undefined : `background:${swatch}`}
                        aria-hidden="true"
                      />
                    )}
                    <span class="cs-value">{v}</span>
                  </span>
                </td>
              );
            })}
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</div>
