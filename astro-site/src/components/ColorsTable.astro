---
import type { ColorsTable as ColorsTableType } from '../data/types';
interface Props { table: ColorsTableType; }
const { table } = Astro.props;
---
<div class="style-colors">
  <div class="style-colors-title">{table.title}</div>
  {table.description && <p class="style-colors-desc" set:html={table.description} />}
  <div class="table-wrap">
    <table>
      <thead>
        <tr>
          <th>Role</th>
          <th>Token</th>
          {table.columns.map((c) => <th>{c}</th>)}
        </tr>
      </thead>
      <tbody>
        {table.rows.map((r) => (
          <tr>
            <td class="muted">{r.role}</td>
            <td class="mono">{r.token}</td>
            {r.values.map((v) => <td class="mono">{v}</td>)}
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</div>
