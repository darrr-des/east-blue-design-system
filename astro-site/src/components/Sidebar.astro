---
import { componentManifest } from '../data/components/_index';
import fs from 'node:fs';
import path from 'node:path';

interface Props {
  activeSlug?: string;
}
const { activeSlug } = Astro.props;
const pathname = Astro.url.pathname;

// Route flags
const isOverview   = pathname === '/';
const isComponents = pathname === '/components' || pathname.startsWith('/components/');
const isSearch     = pathname === '/search';
const isIcons      = pathname === '/icons';
const isStyles     = pathname === '/styles';

// Components panel shows on /components/* (matches Figma "Type=Components" variant)
const showPanel    = isComponents;

// On /components/* the rail is force-collapsed (Figma shows 60px rail + 204px panel = 264px total)
const railCollapsed = isComponents;

// ── Build component rows for the panel ───────────────────────────────
type ManifestItem = (typeof componentManifest)[number];
const DATA_DIR = path.resolve(process.cwd(), 'src/data/components');
type WithBadges = ManifestItem & { badges: { kind: string }[] };

const enriched: WithBadges[] = componentManifest.map((m) => {
  let badges: { kind: string }[] = [];
  try {
    const raw = fs.readFileSync(path.join(DATA_DIR, m.slug + '.ts'), 'utf8');
    const match = raw.match(/= ({[\s\S]*});\s*$/);
    if (match) {
      const data = new Function('return ' + match[1])();
      badges = data?.meta?.badges || [];
    }
  } catch {}
  return { ...m, badges };
});

const groups = new Map<string, WithBadges[]>();
const standalone: WithBadges[] = [];
for (const item of enriched) {
  if (item.navGroup) {
    if (!groups.has(item.navGroup)) groups.set(item.navGroup, []);
    groups.get(item.navGroup)!.push(item);
  } else {
    standalone.push(item);
  }
}
standalone.sort((a, b) => a.name.localeCompare(b.name));
const orderedGroups = [...groups.entries()]
  .map(([k, v]) => [k, [...v].sort((a, b) => a.name.localeCompare(b.name))] as const)
  .sort((a, b) => a[0].localeCompare(b[0]));

type Row =
  | { kind: 'item'; item: WithBadges }
  | { kind: 'group'; name: string; items: WithBadges[] };
const rows: Row[] = [];
let si = 0, gi = 0;
while (si < standalone.length || gi < orderedGroups.length) {
  const sName = standalone[si]?.name;
  const gName = orderedGroups[gi]?.[0];
  if (sName && (!gName || sName.localeCompare(gName) < 0)) {
    rows.push({ kind: 'item', item: standalone[si++] });
  } else if (gName) {
    rows.push({ kind: 'group', name: gName, items: orderedGroups[gi][1] });
    gi++;
  }
}

// Dot color logic — per user spec:
//   restructure / rework / consolidate / remove / product-layer  → red
//   fix / refine                                                 → orange
//   keep / ready / na / empty                                    → no dot
// Family GROUPS never get a dot — only standalone components or items inside an opened group.
const RED = new Set(['restructure', 'rework', 'consolidate', 'remove', 'product-layer']);
const ORANGE = new Set(['fix', 'refine']);
function dotFor(badges: { kind: string }[]): 'red' | 'orange' | null {
  const kinds = badges.map((b) => b.kind);
  if (kinds.some((k) => RED.has(k))) return 'red';
  if (kinds.some((k) => ORANGE.has(k))) return 'orange';
  return null;
}
---
<aside class={`sb${showPanel ? ' sb--has-panel' : ''}${railCollapsed ? ' sb--collapsed' : ''}`} data-route={pathname}>
  {/* ────────  Rail (left)  ──────── */}
  <div class="sb-rail">
    {/* Header: brand + collapse-toggle on the right */}
    <div class="sb-rail-header">
      <a class="sb-brand" href="/" aria-label="East Blue home">
        <span class="sb-brand-text">East Blue</span>
        <span class="sb-brand-version">v0.1.0</span>
      </a>
      <button class="sb-toggle" type="button" onclick="window.__sbToggle && window.__sbToggle()" aria-label="Toggle sidebar">
        {/* Lucide: PanelLeft */}
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <rect width="18" height="18" x="3" y="3" rx="2"/>
          <path d="M9 3v18"/>
        </svg>
      </button>
    </div>

    {/* Nav */}
    <nav class="sb-nav" aria-label="Primary">
      <a class={`sb-item${isSearch ? ' sb-item--active' : ''}`} href="/search" aria-label="Search">
        <span class="sb-icon">
          {/* Lucide: Search */}
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="m21 21-4.34-4.34"/>
            <circle cx="11" cy="11" r="8"/>
          </svg>
        </span>
        <span class="sb-label">Search</span>
      </a>

      <a class={`sb-item${isOverview ? ' sb-item--active' : ''}`} href="/" aria-label="Overview">
        <span class="sb-icon">
          {/* Lucide: Atom */}
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="1"/>
            <path d="M20.2 20.2c2.04-2.03.02-7.36-4.5-11.9-4.54-4.52-9.87-6.54-11.9-4.5-2.04 2.03-.02 7.36 4.5 11.9 4.54 4.52 9.87 6.54 11.9 4.5Z"/>
            <path d="M15.7 15.7c4.52-4.54 6.54-9.87 4.5-11.9-2.03-2.04-7.36-.02-11.9 4.5-4.52 4.54-6.54 9.87-4.5 11.9 2.03 2.04 7.36.02 11.9-4.5Z"/>
          </svg>
        </span>
        <span class="sb-label">Overview</span>
      </a>

      <a class={`sb-item${isComponents ? ' sb-item--active' : ''}`} href="/components" aria-label="Components">
        <span class="sb-icon">
          {/* Lucide: Component */}
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M5.5 8.5 9 12l-3.5 3.5L2 12l3.5-3.5Z"/>
            <path d="m12 2 3.5 3.5L12 9 8.5 5.5 12 2Z"/>
            <path d="M18.5 8.5 22 12l-3.5 3.5L15 12l3.5-3.5Z"/>
            <path d="m12 15 3.5 3.5L12 22l-3.5-3.5L12 15Z"/>
          </svg>
        </span>
        <span class="sb-label">Components</span>
      </a>

      <a class={`sb-item${isIcons ? ' sb-item--active' : ''}`} href="/icons" aria-label="Icons">
        <span class="sb-icon">
          {/* Lucide: Origami */}
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 12V4a1 1 0 0 1 1-1h6.297a1 1 0 0 1 .651 1.759l-4.696 4.025"/>
            <path d="m12 21-7.414-7.414A2 2 0 0 1 4 12.172V6.415a1.002 1.002 0 0 1 1.707-.707L20 20.009"/>
            <path d="m12.214 3.381 8.414 14.966a1 1 0 0 1-.167 1.199l-1.168 1.163a1 1 0 0 1-.706.291H6.351a1 1 0 0 1-.625-.219L3.25 18.8a1 1 0 0 1 .631-1.781l4.165.027"/>
          </svg>
        </span>
        <span class="sb-label">Icons</span>
      </a>

      <a class={`sb-item${isStyles ? ' sb-item--active' : ''}`} href="/styles" aria-label="Styles">
        <span class="sb-icon">
          {/* Lucide: SwatchBook */}
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M11 17a4 4 0 0 1-8 0V5a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2Z"/>
            <path d="M16.7 13H19a2 2 0 0 1 2 2v4a2 2 0 0 1-2 2H7.5"/>
            <path d="m17 14 6.4-6.4a2 2 0 0 0 0-2.8L20.6 2a2 2 0 0 0-2.8 0L11 8.7"/>
            <path d="M7 17h.01"/>
          </svg>
        </span>
        <span class="sb-label">Styles</span>
      </a>
    </nav>

    {/* Footer: dark mode toggle */}
    <div class="sb-rail-footer">
      <button class="sb-item" type="button" onclick="toggleTheme && toggleTheme(document.documentElement.dataset.theme !== 'dark')" aria-label="Toggle dark mode">
        <span class="sb-icon">
          {/* Lucide: Moon */}
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M20.985 12.486a9 9 0 1 1-9.473-9.472c.405-.022.617.46.402.803a6 6 0 0 0 8.268 8.268c.344-.215.825-.004.803.401"/>
          </svg>
        </span>
        <span class="sb-label">Dark mode</span>
      </button>
    </div>
  </div>

  {/* ────────  Components panel (right)  ──────── */}
  {showPanel && (
    <div class="sb-panel">
      <div class="sb-panel-list">
        <a class="sb-panel-header" href="/components">
          <span>Components</span>
        </a>

        {rows.map((row) =>
          row.kind === 'item' ? (
            <a
              class={`sb-panel-item${activeSlug === row.item.slug ? ' sb-panel-item--active' : ''}`}
              href={`/components/${row.item.slug}`}
            >
              <span class="sb-panel-label">{row.item.name}</span>
              {(() => {
                const d = dotFor(row.item.badges);
                return d ? <span class={`sb-dot sb-dot--${d}`} aria-hidden="true"></span> : null;
              })()}
            </a>
          ) : (
            <details class={`sb-panel-group${row.items.some((i) => i.slug === activeSlug) ? ' sb-panel-group--has-active' : ''}`} open={row.items.some((i) => i.slug === activeSlug)}>
              <summary class="sb-panel-item sb-panel-item--group">
                <span class="sb-panel-label">{row.name}</span>
                {/* No dot on family group toggles — only on individual items */}
                <svg class="sb-panel-chevron" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="9 18 15 12 9 6"/>
                </svg>
              </summary>
              <div class="sb-panel-group-list">
                {row.items.map((item) => (
                  <a
                    class={`sb-panel-item sb-panel-item--child${activeSlug === item.slug ? ' sb-panel-item--active' : ''}`}
                    href={`/components/${item.slug}`}
                  >
                    <span class="sb-panel-label">{item.name}</span>
                    {(() => {
                      const d = dotFor(item.badges);
                      return d ? <span class={`sb-dot sb-dot--${d}`} aria-hidden="true"></span> : null;
                    })()}
                  </a>
                ))}
              </div>
            </details>
          )
        )}
      </div>
    </div>
  )}
</aside>

{/* Manual collapse-toggle wiring */}
<script is:inline>
  (function () {
    function readState() {
      try { return localStorage.getItem('sb_manual_collapsed') === '1'; } catch { return false; }
    }
    function apply(state) {
      var sb = document.querySelector('.sb');
      if (!sb) return;
      // The on-/components/* state always force-collapses the rail; the
      // manual toggle only affects routes where the rail is otherwise full.
      if (sb.classList.contains('sb--has-panel')) return;
      sb.classList.toggle('sb--manual-collapsed', state);
    }
    window.__sbToggle = function () {
      var next = !readState();
      try { localStorage.setItem('sb_manual_collapsed', next ? '1' : '0'); } catch {}
      apply(next);
    };
    apply(readState());
    document.addEventListener('astro:page-load', function () { apply(readState()); });
  })();
</script>
