---
import { componentManifest } from '../data/components/_index';
import { url } from '../lib/url';

interface Props {
  activeSlug?: string;
}
const { activeSlug } = Astro.props;
const pathname = Astro.url.pathname;

type Item = (typeof componentManifest)[number];

// Map a component to its status-dot colour.
//
// Two axes feed this. The DS verdict says whether the component belongs in the
// system and is structurally sound; Native Readiness says whether a developer
// can consume it yet. Colouring on the DS verdict alone hid the 50 components
// that are `keep` but still carry an open Code Connect issue, so those read as
// finished when they are not.
//
//   red    restructure                    — significant structural work
//   orange fix, or `refine` with anything
//          still open (usually Code Connect)
//   grey   remove / consolidate           — retired; the work lives elsewhere
//          / product-layer
//   none   nothing outstanding
const DS_VERDICTS = ['keep', 'fix', 'restructure', 'consolidate', 'product-layer', 'remove'] as const;
type DotStatus = 'rework' | 'fix' | 'na';

function statusFromBadges(
  badges?: { kind: string }[],
  openIssues: number = 0,
): DotStatus | null {
  if (!badges || badges.length === 0) return null;
  const verdict = badges.find((b) => (DS_VERDICTS as readonly string[]).includes(b.kind))?.kind;
  if (verdict === 'restructure') return 'rework';
  if (verdict === 'remove' || verdict === 'consolidate' || verdict === 'product-layer') return 'na';
  if (verdict === 'fix') return 'fix';
  /* `keep` with an unresolved issue is not finished — Code Connect is the
     usual one, and it is the reason most of the system reads `refine`. */
  if (openIssues > 0 && badges.some((b) => b.kind === 'refine')) return 'fix';
  return null;
}

const groups = new Map<string, Item[]>();
const standalone: Item[] = [];

for (const item of componentManifest) {
  if (item.navGroup) {
    if (!groups.has(item.navGroup)) groups.set(item.navGroup, []);
    groups.get(item.navGroup)!.push(item);
  } else {
    standalone.push(item);
  }
}

standalone.sort((a, b) => a.name.localeCompare(b.name));
const orderedGroups = [...groups.entries()]
  .map(([k, v]) => [k, [...v].sort((a, b) => a.name.localeCompare(b.name))] as const)
  .sort((a, b) => a[0].localeCompare(b[0]));

// Weave standalone items + group headers alphabetically
type Row = { kind: 'item'; item: Item } | { kind: 'group'; name: string; items: Item[] };
const rows: Row[] = [];
let si = 0;
let gi = 0;
while (si < standalone.length || gi < orderedGroups.length) {
  const sName = standalone[si]?.name;
  const gName = orderedGroups[gi]?.[0];
  if (sName && (!gName || sName.localeCompare(gName) < 0)) {
    rows.push({ kind: 'item', item: standalone[si++] });
  } else if (gName) {
    rows.push({ kind: 'group', name: gName, items: orderedGroups[gi][1] });
    gi++;
  }
}

// Strip the deploy base before matching routes — on the Pages subpath deploy
// pathname is '/east-blue-design-system/components', not '/components'.
const basePath = url('/');
const route = pathname.startsWith(basePath) ? `/${pathname.slice(basePath.length)}` : pathname;

const isOverview        = route === '/';
const isComponentsGrid  = route === '/components';                          // on the grid page itself → highlight active
const componentsOpen    = isComponentsGrid || route.startsWith('/components/'); // expand the list whenever inside Components
const isIcons           = route === '/icons';
const isStyles          = route === '/styles';
---
<aside class="sidebar">
  <a class="sidebar-brand" href={url("/")}>
    <div class="sidebar-brand-row">
      <div class="sidebar-logo">
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
          <rect x="1" y="1" width="5" height="5" rx="1" fill="#fff" />
          <rect x="9" y="1" width="5" height="5" rx="1" fill="#fff" opacity=".75" />
          <rect x="1" y="9" width="5" height="5" rx="1" fill="#fff" opacity=".75" />
          <rect x="9" y="9" width="5" height="5" rx="1" fill="#fff" opacity=".45" />
        </svg>
      </div>
      <div class="sidebar-brand-text">
        <div class="sidebar-brand-title-row">
          <span class="sidebar-wordmark">East Blue</span>
          <span class="sidebar-version">v0.1.0</span>
        </div>
        <span class="sidebar-brand-sub">Component Assessment</span>
      </div>
    </div>
  </a>

  <nav class="sidebar-nav" id="comp-list">
    {/* Search trigger — first row inside the nav. Opens SearchModal. */}
    <button
      class="sidebar-search"
      type="button"
      data-action="open-search"
      aria-label="Open search"
    >
      <svg class="sidebar-search-icon" width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true">
        <circle cx="7" cy="7" r="4.5" stroke="currentColor" stroke-width="1.5" />
        <path d="M10.5 10.5L13 13" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
      </svg>
      <span class="sidebar-search-label">Search…</span>
    </button>

    {/* Top-level nav */}
    <a class={`nav-item${isOverview ? ' active' : ''}`} href={url("/")}>Overview</a>

    <div class={`nav-item-row${isComponentsGrid ? ' active' : ''}${componentsOpen ? ' open' : ''}`}>
      <a
        class={`nav-item nav-item-toggleable${isComponentsGrid ? ' active' : ''}`}
        href={url("/components")}
        onclick="toggleComponentsSection(event, false)"
      >
        <span>Components</span>
      </a>
      <button class="nav-item-chevron-btn" onclick="toggleComponentsSection(event, true)" aria-label="Toggle components list">
        <svg class="nav-section-chevron" width="12" height="12" viewBox="0 0 16 16" fill="none">
          <path d="M5 6l3 3 3-3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </button>
    </div>
    <div class={`nav-section-list nav-components-list${componentsOpen ? ' open' : ''}`}>
      <div class="nav-section-list-inner">
        {rows.map((row) =>
          row.kind === 'item' ? (
            <a
              class={`nav-comp${activeSlug === row.item.slug ? ' active' : ''}`}
              href={url(`/components/${row.item.slug}`)}
            >
              {row.item.navIconSvg && (
                <div class="nav-comp-icon" set:html={row.item.navIconSvg} />
              )}
              <div class="nav-comp-body">
                <div class="nav-comp-name">{row.item.name}</div>
              </div>
              {statusFromBadges(row.item.badges, row.item.openIssues) && (
                <span class={`nav-comp-status ${statusFromBadges(row.item.badges, row.item.openIssues)}`} aria-hidden="true" />
              )}
            </a>
          ) : (
            <>
              <button
                class={`nav-section-toggle nav-family-toggle${row.items.some((i) => i.slug === activeSlug) ? ' open' : ''}`}
                onclick="toggleNavSection(this)"
              >
                <span>{row.name}</span>
                <svg class="nav-section-chevron" width="12" height="12" viewBox="0 0 16 16" fill="none">
                  <path d="M5 6l3 3 3-3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </button>
              <div class={`nav-section-list${row.items.some((i) => i.slug === activeSlug) ? ' open' : ''}`}>
                <div class="nav-section-list-inner">
                  {row.items.map((item) => (
                    <a
                      class={`nav-comp${activeSlug === item.slug ? ' active' : ''}`}
                      href={url(`/components/${item.slug}`)}
                    >
                      {item.navIconSvg && (
                        <div class="nav-comp-icon" set:html={item.navIconSvg} />
                      )}
                      <div class="nav-comp-body">
                        <div class="nav-comp-name">{item.name}</div>
                      </div>
                      {statusFromBadges(item.badges, item.openIssues) && (
                        <span class={`nav-comp-status ${statusFromBadges(item.badges, item.openIssues)}`} aria-hidden="true" />
                      )}
                    </a>
                  ))}
                </div>
              </div>
            </>
          )
        )}
      </div>
    </div>

    <a class={`nav-item${isIcons ? ' active' : ''}`} href={url("/icons")}>Icons</a>
    <a class={`nav-item${isStyles ? ' active' : ''}`} href={url("/styles")}>Styles</a>
  </nav>

  <!-- User info + logout (populated by AuthGate via window.__ebUser) -->
  <div class="sidebar-user" id="sidebar-user" style="display:none;">
    <img class="sidebar-user-avatar" id="sidebar-user-avatar" alt="" referrerpolicy="no-referrer" />
    <div class="sidebar-user-text">
      <div class="sidebar-user-name" id="sidebar-user-name"></div>
      <div class="sidebar-user-email" id="sidebar-user-email"></div>
    </div>
    <button class="sidebar-user-logout" onclick="window.__ebSignOut && window.__ebSignOut()" title="Sign out" aria-label="Sign out">
      <svg width="14" height="14" viewBox="0 0 16 16" fill="none">
        <path d="M6 3H4a1 1 0 0 0-1 1v8a1 1 0 0 0 1 1h2" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
        <path d="M9 5l3 3-3 3M12 8H6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </button>
  </div>
</aside>
