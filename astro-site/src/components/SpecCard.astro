---
/*
 * SpecCard — the canonical Style-tab card.
 *
 * Props:
 *   cardKey       unique id for DES/DEV toggle wiring (e.g. "btn-filled-large")
 *   title         card heading (e.g. "Filled · Large · Default")
 *   node          Figma node id (e.g. "17104:184842")
 *   description   one-line card description
 *   previewHtml   raw HTML for the visual preview area (optional)
 *   sections      DES-view spec sections — array of { label, rows: [{ key, value, mono? }] }
 *   swift         SwiftUI code block (already syntax-marked with syn-* spans, or plain)
 *   compose       Compose code block
 */

interface SpecRow {
  key: string;
  value: string;
  mono?: boolean;
  token?: string;
  swatch?: boolean;
  prop?: string;
}
interface SpecSection {
  label: string;
  rows: SpecRow[];
  slug?: string;
}
interface DemoControlOption {
  value: string;
  label: string;
}
interface DemoControlRow {
  label: string;
  prop: string;
  options: DemoControlOption[];
  defaultValue?: string;
}
interface DemoControlSection {
  heading: string;
  rows: DemoControlRow[];
}
interface Props {
  cardKey: string;
  demoKey?: string;
  title: string;
  node: string;
  description: string;
  previewHtml?: string;
  demoControls?: DemoControlSection[];
  sections: SpecSection[];
  swift: string;
  compose: string;
}
const { cardKey, demoKey, title, node, description, previewHtml, demoControls, sections, swift, compose } = Astro.props;
const updateKey = demoKey || cardKey;
---
<div class="spec-card" id={`spec-card-${cardKey}`}>
  <div class="spec-card-header">
    <div class="spec-card-header-row">
      <div class="sub-heading toc-child" id={`variant-${cardKey}`} style="margin-top:0">
        {title}
      </div>
      <button class="spec-node-copy" onclick="copyNode(this)" data-node={node} title="Copy Figma node ID">
        <svg width="12" height="12" viewBox="0 0 16 16" fill="none">
          <rect x="5" y="5" width="9" height="9" rx="1.5" stroke="currentColor" stroke-width="1.3" />
          <path d="M11 5V3.5A1.5 1.5 0 009.5 2h-6A1.5 1.5 0 002 3.5v6A1.5 1.5 0 003.5 11H5" stroke="currentColor" stroke-width="1.3" />
        </svg>
        <span>{node}</span>
      </button>
      <div class="spec-mode-toggle" onclick={`toggleSpecMode('${updateKey}', this)`}>
        <span class="spec-mode-label active">DES</span>
        <span class="spec-mode-label">DEV</span>
      </div>
    </div>
    <p class="spec-card-desc">{description}</p>
  </div>

  {previewHtml && demoControls && demoControls.length > 0 ? (
    <div class="demo-layout">
      <div class="spec-card-preview eb-preview-scope" set:html={previewHtml} />
      <div class="demo-figma-panel">
        {demoControls.map((section) => (
          <div class="demo-panel-section">
            <div class="demo-panel-heading">{section.heading}</div>
            {section.rows.map((row) => (
              <div class="demo-panel-row">
                <span class="demo-panel-label">{row.label}</span>
                <select
                  class="demo-panel-select"
                  onchange={`updateSpecCard('${updateKey}', '${row.prop}', this.value)`}
                >
                  {row.options.map((opt) => (
                    <option value={opt.value} selected={row.defaultValue === opt.value}>
                      {opt.label}
                    </option>
                  ))}
                </select>
              </div>
            ))}
          </div>
        ))}
      </div>
    </div>
  ) : previewHtml ? (
    <div class="spec-card-preview-row">
      <div class="spec-preview-frame">
        <div class="spec-preview-body" set:html={previewHtml} />
      </div>
    </div>
  ) : null}

  <div class="spec-card-detail spec-view-des" data-view={`${updateKey}-des`}>
    {sections.map((section) => {
      const sectionSlug = section.slug || section.label.toLowerCase();
      const sectionId = `spec-${updateKey}-${sectionSlug}`;
      return (
        <div class="spec-detail-section" id={sectionId}>
          <div class="spec-detail-label">{section.label}</div>
          <div class="spec-props">
            {section.rows.map((row) => {
              const isHex = typeof row.value === 'string' && row.value.trim().startsWith('#');
              const showSwatch = row.swatch ?? isHex;
              const dataSp = row.prop ? `${updateKey}-${row.prop}` : undefined;
              /* Serialize variants map for client-side patching. The shared
                 assessment.js listens for spec-card control changes and uses
                 this attribute to swap the row's value/token. */
              const variantsJson = row.variants && Object.keys(row.variants).length > 0
                ? JSON.stringify(row.variants)
                : undefined;
              return (
                <div class={`spec-prop${row.token ? ' has-token' : ''}`}>
                  <span class="spec-prop-key">{row.key}</span>
                  <span
                    class={`spec-prop-val${row.mono ? ' mono' : ''}`}
                    data-sp={dataSp}
                    data-row-card={variantsJson ? updateKey : undefined}
                    data-row-variants={variantsJson}
                  >
                    {showSwatch && (
                      <span class="spec-swatch" style={`background:${row.value}`} aria-hidden="true"></span>
                    )}
                    <span class="spec-prop-hex" set:html={row.value} />
                  </span>
                  {/* Token path is documented in the standalone
                      `colorsTables` block below the spec cards — no
                      need to repeat it here. The `row.token` data
                      stays in case we want to surface it later. */}
                </div>
              );
            })}
          </div>
        </div>
      );
    })}
  </div>

  <div class="spec-card-detail spec-card-code" data-view={`${updateKey}-dev`} style="display:none">
    <div class="spec-code-tabs">
      <button class="spec-code-tab active" onclick={`switchCodeTab(this, 'swift', '${updateKey}')`}>SWIFTUI</button>
      <button class="spec-code-tab" onclick={`switchCodeTab(this, 'compose', '${updateKey}')`}>COMPOSE</button>
    </div>
    {/* Single <code> block — initial content is the SwiftUI HTML from
        the data file (gives us a syntax-highlighted SSR fallback when
        JS is off). On JS load, the per-component demo script's
        `updateSpecCard()` swaps `data-final` to plaintext and the
        shared `highlightSyntax()` re-applies highlighting. */}
    <pre class="spec-code-block"><code data-code-content={updateKey} data-lang="swift" set:html={swift} /></pre>
  </div>
</div>
