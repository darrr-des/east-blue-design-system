---
/*
 * SpecCard — the canonical Style-tab card (STYLE-REVIEW-GUIDE.md).
 *
 * Header: title + DES/DEV toggle. Preview with the demo panel when the
 * card has controls, a static frame otherwise. The four DES sections
 * (Properties → Colors → Typography → Layout) in the two-column detail
 * grid, then the DEV code block that the demo script keeps live via
 * `getSnippet`.
 */
import type { SpecCardData } from '../data/types';

type Props = SpecCardData;
const { cardKey, demoKey, title, previewHtml, demoControls, sections, swift } = Astro.props;
const updateKey = demoKey || cardKey;

/* Examples card (STYLE-REVIEW-GUIDE §3.1): the Properties row named after the
   card is the card's own property, and it lists every drawn value " · "-joined.
   Only on such a card does " · " mean one value per example — everywhere else
   it is punctuation inside a single value ("Proxima Soft Semibold · 16 / 16"),
   which must stay one string. */
const ownRow = sections.find((s) => s.label === 'Properties')?.rows.find((r) => r.key === title);
const exampleCount = ownRow ? String(ownRow.value).split(' · ').length : 1;
const isExamples = exampleCount > 1;
/* Two values sit beside the key; three or more fit on some rows only, which
   leaves the column ragged. Past two, every multi-value row in the card drops
   to its own line, so the treatment is the same down the whole card. */
const stack = exampleCount > 2;
---
<div class="spec-card" id={`spec-card-${cardKey}`}>
  <div class="spec-card-header">
    <div class="spec-card-header-row">
      <div class="sub-heading toc-child" id={`variant-${cardKey}`} style="margin-top:0">
        {title}
      </div>
      <div class="spec-mode-toggle" role="tablist" aria-label="Design or developer view">
        <button type="button" class="spec-mode-label active" role="tab" aria-selected="true" onclick={`toggleSpecMode('${updateKey}', this.parentElement, 'des')`}>DES</button>
        <button type="button" class="spec-mode-label" role="tab" aria-selected="false" onclick={`toggleSpecMode('${updateKey}', this.parentElement, 'dev')`}>DEV</button>
      </div>
    </div>
  </div>

  {previewHtml && demoControls && demoControls.length > 0 ? (
    <div class="demo-layout">
      <div class="spec-card-preview eb-preview-scope" set:html={previewHtml} />
      <div class="demo-figma-panel">
        {demoControls.map((section) => (
          <div class="demo-panel-section">
            <div class="demo-panel-heading">{section.heading}</div>
            {section.rows.map((row) => {
              const isToggle = row.control === 'toggle';
              const isInput  = row.control === 'input';
              const onValue  = isToggle ? (row.options[1]?.value ?? 'yes') : '';
              const offValue = isToggle ? (row.options[0]?.value ?? 'no')  : '';
              const isOn     = isToggle && row.defaultValue === onValue;
              return (
                <div class="demo-panel-row" data-panel-card={updateKey} data-panel-prop={row.prop}>
                  <span class="demo-panel-label">{row.label}</span>
                  {isInput ? (
                    <input
                      type="text"
                      class="demo-panel-select demo-panel-input"
                      value={row.defaultValue ?? ''}
                      placeholder={row.label}
                      oninput={`updateSpecCard('${updateKey}', '${row.prop}', this.value)`}
                    />
                  ) : isToggle ? (
                    <label class={`demo-panel-toggle${isOn ? ' is-on' : ''}`}>
                      <input
                        type="checkbox"
                        checked={isOn}
                        data-on-value={onValue}
                        data-off-value={offValue}
                        onchange={`updateSpecCard('${updateKey}', '${row.prop}', this.checked ? this.dataset.onValue : this.dataset.offValue); this.parentElement.classList.toggle('is-on', this.checked);`}
                      />
                      <span class="demo-panel-toggle__track"><span class="demo-panel-toggle__thumb"/></span>
                    </label>
                  ) : (
                    <select
                      class="demo-panel-select"
                      onchange={`updateSpecCard('${updateKey}', '${row.prop}', this.value)`}
                    >
                      {row.options.map((opt) => (
                        <option value={opt.value} selected={row.defaultValue === opt.value}>
                          {opt.label}
                        </option>
                      ))}
                    </select>
                  )}
                </div>
              );
            })}
          </div>
        ))}
      </div>
    </div>
  ) : previewHtml ? (
    <div class="spec-card-preview-row">
      <div class="spec-preview-frame">
        <div class="spec-preview-body" set:html={previewHtml} />
      </div>
    </div>
  ) : null}

  <div class={`spec-card-detail spec-view-des${stack ? ' spec-view-des--stack' : ''}`} data-view={`${updateKey}-des`}>
    {sections.map((section) => {
      const sectionId = `spec-${updateKey}-${section.slug || section.label.toLowerCase()}`;
      return (
        <div class="spec-detail-section" id={sectionId}>
          <div class="spec-detail-label">{section.label}</div>
          <div class="spec-props">
            {section.rows.map((row) => {
              const isHex = typeof row.value === 'string' && row.value.trim().startsWith('#');
              const showSwatch = row.swatch ?? isHex;
              const dataSp = row.prop ? `${updateKey}-${row.prop}` : undefined;
              /* `variants` is serialized for assessment.js → _patchSpecCardRows,
                 which swaps value/token on each demo-control change. */
              const variantsJson = row.variants && Object.keys(row.variants).length > 0
                ? JSON.stringify(row.variants)
                : undefined;
              /* An Examples card lists one value per drawn example, joined
                 with " · " — each part gets its own swatch when it is a hex.
                 assessment.js → _applyRowValue rebuilds the same markup on
                 every control change. */
              const parts = isExamples ? String(row.value ?? '').split(' · ') : [];
              const multi = parts.length > 1;
              return (
                <div class={`spec-prop${row.token ? ' has-token' : ''}`}>
                  <span class="spec-prop-key">{row.key}</span>
                  <span
                    class={`spec-prop-val${row.mono ? ' mono' : ''}${multi ? ' multi' : ''}`}
                    data-sp={dataSp}
                    data-row-card={variantsJson ? updateKey : undefined}
                    data-row-variants={variantsJson}
                    data-row-value={variantsJson ? row.value : undefined}
                  >
                    {multi ? parts.map((p, i) => (
                      <>
                        {i > 0 && <span class="spec-prop-sep" aria-hidden="true">·</span>}
                        <span class="spec-prop-part">
                          {p.trim().startsWith('#') && <span class="spec-swatch" style={`background:${p.trim()}`} aria-hidden="true"></span>}
                          <span class="spec-prop-hex" set:html={p} />
                        </span>
                      </>
                    )) : (
                      <>
                        {showSwatch && (
                          <span class="spec-swatch" style={`background:${row.value}`} aria-hidden="true"></span>
                        )}
                        <span class="spec-prop-hex" set:html={row.value} />
                      </>
                    )}
                  </span>
                </div>
              );
            })}
          </div>
        </div>
      );
    })}
    {/* The detail is a two-column grid: an odd number of sections would
        leave the last cell empty, showing the grid's rule colour as a grey
        void. This fills it with the section surface instead. */}
    {sections.length % 2 === 1 && <div class="spec-detail-section spec-detail-filler" aria-hidden="true"></div>}
  </div>

  <div class="spec-card-detail spec-card-code" data-view={`${updateKey}-dev`} style="display:none">
    <div class="spec-code-tabs">
      <button class="spec-code-tab active" onclick={`switchCodeTab(this, 'swift', '${updateKey}')`}>SWIFTUI</button>
      <button class="spec-code-tab" onclick={`switchCodeTab(this, 'compose', '${updateKey}')`}>COMPOSE</button>
    </div>
    {/* Server-rendered SwiftUI fallback; the demo script's getSnippet()
        replaces it on load and on every control change. */}
    <pre class="spec-code-block"><code data-code-content={updateKey} data-lang="swift" set:html={swift} /></pre>
  </div>
</div>
