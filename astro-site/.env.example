# ─────────────────────────────────────────────────────────────────────
# East Blue Astro site — environment template
# Copy to .env.local for local development. Never commit real values.
# ─────────────────────────────────────────────────────────────────────

# URL of the frost-auth backend (Google OAuth + JWT service).
# In dev:   http://localhost:3001
# In prod:  https://auth.frostdesigngroup.com
PUBLIC_AUTH_BACKEND_URL=http://localhost:3001

# Google OAuth Client ID (must match the one configured in frost-auth).
# Get it from Google Cloud Console → Credentials.
PUBLIC_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
