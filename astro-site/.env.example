# ─────────────────────────────────────────────────────────────────────
# East Blue Astro site — environment template
# Copy to .env.local for local development. Never commit real values.
# ─────────────────────────────────────────────────────────────────────

# URL of the frost-auth backend (Google OAuth + JWT service).
# In dev:   http://localhost:3001
# In prod:  https://auth.frostdesigngroup.com
PUBLIC_AUTH_BACKEND_URL=http://localhost:3001

# Google OAuth Client ID (must match the one configured in frost-auth).
# Get it from Google Cloud Console → Credentials.
PUBLIC_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Optional — set to "true" to disable the auth gate entirely (useful when
# the backend isn't running or for local previews). Leave unset / blank
# in production.
PUBLIC_AUTH_DISABLED=

# ─────────────────────────────────────────────────────────────────────
# Visual regression — Figma baseline export (see .claude/plans/visual-regression-plan.md)
# ─────────────────────────────────────────────────────────────────────

# Personal-access token (read-only scope sufficient).
# Get one at https://www.figma.com/developers/api#access-tokens
FIGMA_ACCESS_TOKEN=

# Sticker Sheet v2 file key. Default — only override when moving to a new file.
FIGMA_FILE_KEY=HwWDwPit2xJjDH4zszOZ5o

