# ─────────────────────────────────────────────────────────────────────
# frost-auth environment template
# Copy to .env and fill in real values. Never commit .env.
# ─────────────────────────────────────────────────────────────────────

# Google OAuth Client ID (from Google Cloud Console → Credentials)
# Used to verify the ID token sent from the frontend.
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Secret used to sign JWTs. Make this long and random.
# Generate: openssl rand -hex 64
JWT_SECRET=replace-with-a-long-random-string

# How long issued JWTs stay valid. Format: Vercel's `ms` syntax (e.g. 7d, 24h, 30m).
JWT_EXPIRES_IN=7d

# Port the server listens on.
PORT=3001

# Comma-separated list of email domains allowed to log in.
# Anyone signing in with a Google account outside these domains will be rejected.
ALLOWED_DOMAINS=frostdesigngroup.com,gcash.com

# Comma-separated list of frontend origins allowed via CORS.
# Use * to allow any origin (fine for dev; tighten in production).
ALLOWED_ORIGINS=*
